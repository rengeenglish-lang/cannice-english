/**
 * Builds content/dictionary/bulk/*.ts from the hand-written sources in content/dictionary/raw/*.txt.
 * Raw line format (fields separated by "|"):  CATEGORY|word|pos|Turkish meaning|English example|Turkish example
 * CATEGORY is GENERAL, ACADEMIC, HEALTH, SCIENCE or SOCIAL. Lines starting with "#" are ignored.
 * Rows whose headword already exists in any other source (or earlier in the raw files) are dropped.
 * Run: npx tsx scripts/build-dictionary-bulk.mts
 */
import fs from "node:fs";
import path from "node:path";
import { A1 } from "../content/vocabulary/a1";
import { A2 } from "../content/vocabulary/a2";
import { B1 } from "../content/vocabulary/b1";
import { B2 } from "../content/vocabulary/b2";
import { C1 } from "../content/vocabulary/c1";
import { CORE_WORDS } from "../content/dictionary/core";
import { EXTENDED_WORDS } from "../content/dictionary/extended";
import { ACADEMIC_WORDS } from "../content/dictionary/academic";
import { DOMAIN_GLOSSARY } from "../content/dictionary/domains";
import { UNITS } from "../content/phrasal-verbs";
import { headwordKey } from "../lib/dictionary/text";

const norm = (w: string) => headwordKey(w).replace(/-/g, " ").replace(/\s+/g, " ").trim();
const CATS = new Set(["GENERAL", "ACADEMIC", "HEALTH", "SCIENCE", "SOCIAL"]);
const POS = new Set(["n", "v", "adj", "adv", "prep", "pron", "conj", "det", "num", "int", "phr", "pv", "modal"]);

const seen = new Set<string>([
  ...[...A1, ...A2, ...B1, ...B2, ...C1, ...CORE_WORDS, ...EXTENDED_WORDS, ...ACADEMIC_WORDS].map(([w]) => norm(w)),
  ...DOMAIN_GLOSSARY.map(([, w]) => norm(w)),
  ...UNITS.flatMap((u) => u.verbs.map((v) => norm(v.pv))),
]);

const root = path.resolve(import.meta.dirname, "../content/dictionary");
const rawDir = path.join(root, "raw");
const outDir = path.join(root, "bulk");
const files = fs.readdirSync(rawDir).filter((f) => f.endsWith(".txt")).sort();
let kept = 0, dup = 0, bad = 0;
const modules: string[] = [];
for (const f of files) {
  const rows: string[] = [];
  fs.readFileSync(path.join(rawDir, f), "utf8").split("\n").forEach((line, i) => {
    if (!line.trim() || line.startsWith("#")) return;
    const p = line.split("|").map((s) => s.trim());
    if (p.length !== 6 || !CATS.has(p[0]) || !POS.has(p[2]) || p.slice(1).some((s) => !s)) {
      bad++; console.warn(`bad row ${f}:${i + 1}: ${line.slice(0, 80)}`); return;
    }
    const k = norm(p[1]);
    if (!k || seen.has(k)) { dup++; return; }
    seen.add(k); kept++;
    rows.push(`  [${p.map((s) => JSON.stringify(s)).join(", ")}],`);
  });
  const name = f.replace(/\.txt$/, "");
  const id = "BULK_" + name.replace(/[^a-z0-9]/gi, "_").toUpperCase();
  fs.writeFileSync(
    path.join(outDir, `${name}.ts`),
    `// Generated by scripts/build-dictionary-bulk.mts from raw/${f}. Edit the .txt file, not this one.\nimport type { BulkEntry } from "../bulk-types";\n\nexport const ${id}: BulkEntry[] = [\n${rows.join("\n")}\n];\n`,
  );
  modules.push(`${name}|${id}`);
}
const imports = modules.map((m) => { const [n, id] = m.split("|"); return `import { ${id} } from "./${n}";`; });
fs.writeFileSync(
  path.join(outDir, "index.ts"),
  `// Generated by scripts/build-dictionary-bulk.mts.\nimport type { BulkEntry } from "../bulk-types";\n${imports.join("\n")}\n\nexport const BULK_WORDS: BulkEntry[] = [${modules.map((m) => `...${m.split("|")[1]}`).join(", ")}];\n`,
);
console.log(`kept ${kept}, duplicates dropped ${dup}, bad rows ${bad}, files ${files.length}`);
