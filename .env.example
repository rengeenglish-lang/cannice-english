# Required: PostgreSQL connection string (pooled, used at runtime).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Required for migrations: direct (unpooled) PostgreSQL connection string.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Required in production: at least 32 random bytes.
AUTH_SECRET="replace-with-a-long-random-secret"

# Required in production: canonical HTTPS application origin used by Auth.js.
AUTH_URL="https://example.com"

# Optional future provider. Do not set until Iyzico integration is implemented.
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=

# PayPal checkout. Get these from developer.paypal.com -> Apps & Credentials -> Sandbox
# (use a Live app's credentials only once you're ready to accept real payments).
# PAYPAL_CLIENT_ID must be duplicated into NEXT_PUBLIC_PAYPAL_CLIENT_ID (same value) so the
# PayPal JS SDK can load client-side -- it is a public identifier, safe to expose.
# PAYPAL_ENVIRONMENT is "sandbox" or "live"; defaults to "sandbox" if unset.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=sandbox
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# `npm test` reads DATABASE_URL from .env.test (gitignored, not this file) instead of .env, so
# tests never run against your real dev database. Create .env.test with a *_test-suffixed local
# database, e.g.:
# DATABASE_URL="postgresql://USER@localhost:5432/DATABASE_test"
# DATABASE_URL_UNPOOLED="postgresql://USER@localhost:5432/DATABASE_test"

# Daily cron (vercel.json → /api/cron/billing) that sends monthly group-lesson payment notices.
# Vercel sends it as "Authorization: Bearer $CRON_SECRET"; the route refuses requests without it.
# CRON_SECRET="replace-with-a-long-random-secret"

# Tawk.to live chat (Yardım Masası). From dashboard.tawk.to → Administration → Chat Widget, the
# embed URL is https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>. Leave unset to hide the widget.
# NEXT_PUBLIC_TAWK_PROPERTY_ID=
# NEXT_PUBLIC_TAWK_WIDGET_ID=
