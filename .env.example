# Required: PostgreSQL connection string (pooled, used at runtime).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Required for migrations: direct (unpooled) PostgreSQL connection string.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Required in production: at least 32 random bytes.
AUTH_SECRET="replace-with-a-long-random-secret"

# Required in production: canonical HTTPS application origin used by Auth.js, the sitemap,
# robots.txt and Open Graph links. Production: https://netfener.com (apex; www redirects to it).
AUTH_URL="https://netfener.com"

# Optional future provider. Do not set until Iyzico integration is implemented.
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=

# PayPal checkout. Get these from developer.paypal.com -> Apps & Credentials -> Sandbox
# (use a Live app's credentials only once you're ready to accept real payments).
# PAYPAL_CLIENT_ID must be duplicated into NEXT_PUBLIC_PAYPAL_CLIENT_ID (same value) so the
# PayPal JS SDK can load client-side -- it is a public identifier, safe to expose.
# PAYPAL_ENVIRONMENT is "sandbox" or "live"; defaults to "sandbox" if unset.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=sandbox
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# `npm test` reads DATABASE_URL from .env.test (gitignored, not this file) instead of .env, so
# tests never run against your real dev database. Create .env.test with a *_test-suffixed local
# database, e.g.:
# DATABASE_URL="postgresql://USER@localhost:5432/DATABASE_test"
# DATABASE_URL_UNPOOLED="postgresql://USER@localhost:5432/DATABASE_test"

# Daily crons (vercel.json): /api/cron/billing sends monthly group-lesson payment notices;
# /api/cron/coaching refreshes Ücretsiz Öğrenci Koçluğu plans/reports and sends due in-app follow-ups.
# Vercel sends it as "Authorization: Bearer $CRON_SECRET"; the route refuses requests without it.
# CRON_SECRET="replace-with-a-long-random-secret"

# Tawk.to live chat (Yardım Masası). From dashboard.tawk.to → Administration → Chat Widget, the
# embed URL is https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>. Optional: the production widget's IDs are
# built into components/support/LiveChatWidget.tsx; set these only to use a different widget.
# NEXT_PUBLIC_TAWK_PROPERTY_ID=
# NEXT_PUBLIC_TAWK_WIDGET_ID=

# Coaching emails (opt-in reminders + weekly report) go through Resend (server/email/send.ts). Leave
# unset to keep email off; the "E-posta bildirimleri" setting then shows as unavailable. The domain
# in EMAIL_FROM must be verified in Resend (add its SPF/DKIM DNS records), and AUTH_SECRET signs the
# one-click unsubscribe links. Sent from the daily coaching cron and the hourly coaching-email cron.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Netfener <bildirim@netfener.com>"

# Optional caps for the student AI helpers (Claude Haiku 5.5), in USD per month; 0 turns one off.
# WRITING_AI_MONTHLY_USD=25
# MISTAKE_AI_MONTHLY_USD=10

# Optional (SEO Phase 5): Google Search Console API. Leave unset to keep the integration disabled.
# GSC_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
# GSC_SITE_URL=sc-domain:netfener.com

# Optional: "Google ile giriş / üye ol". Leave unset to hide the Google buttons.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application),
# authorized redirect URI: https://netfener.com/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Optional (SEO Phase 9): Claude-written articles. All three are required before the autopilot can spend anything;
# without them the Otomasyon page shows the feature as not ready. Prices are per million tokens, copied from Anthropic's
# pricing page for the model selected in Admin > SEO > Ayarlar (used by the AI budget ledger).
# ANTHROPIC_API_KEY=
# SEO_AI_INPUT_USD_PER_MTOK=2
# SEO_AI_OUTPUT_USD_PER_MTOK=10
