generator client {
  provider      = "prisma-client"
  output        = "../lib/generated/prisma"
  moduleFormat  = "esm"
}

datasource db {
  provider = "postgresql"
}

// ====================================================================
// ENUMS
// ====================================================================

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN
}

enum ExamCode {
  IELTS
  TOEFL
  PTE
  YDS
  YOKDIL_SOSYAL
  YOKDIL_SAGLIK
  YOKDIL_FEN
}

enum ProductCategory {
  PREP_GROUP
  MOCK_CAMP
  STUDY_PACKAGE
  TRANSLATION_SUPPORT
  BOOK
}

enum ProductLevel {
  BEGINNER_TO_ADVANCED
  INTERMEDIATE_ADVANCED
  JUNIOR
  SENIOR
}

enum CourseDeliveryFormat {
  HYBRID
  RECORDED_ONLY
  LIVE_ONLY
}

enum BookFormat {
  PDF
  PRINT
  PRINT_AND_PDF
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum OrderStatus {
  PAYMENT_REVIEW
  PENDING
  AWAITING_PAYMENT
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum CallbackRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

// ====================================================================
// REFERENCE DATA
// ====================================================================

model ExamType {
  id               String   @id @default(cuid())
  code             ExamCode @unique
  slug             String   @unique
  name             String
  shortDescription String?
  iconKey          String?
  displayOrder     Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products           Product[]
  testimonials       Testimonial[]
  dictionaryTerms    DictionaryTerm[]
  scoreConversionRows ScoreConversionEntry[]
  calendarEntries    ExamCalendarEntry[]
  freeResources      FreeResource[]
  callbackRequests   CallbackRequest[]
  topics             ExamTopic[]

  @@map("exam_types")
}

// ====================================================================
// KONU ANLATIM (FREE TOPIC LEARNING DASHBOARD)
// ====================================================================

model ExamTopic {
  id            String   @id @default(cuid())
  examTypeId    String
  name          String
  slug          String
  description   String?
  questionCount Int?
  category      String?
  skillsTested  String?
  difficulty    String?
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examType ExamType      @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  lessons  TopicLesson[]
  notes    TopicNote[]

  @@unique([examTypeId, slug])
  @@index([examTypeId])
  @@map("exam_topics")
}

model TopicNote {
  id          String   @id @default(cuid())
  userId      String
  examTopicId String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic ExamTopic @relation(fields: [examTopicId], references: [id], onDelete: Cascade)

  @@unique([userId, examTopicId])
  @@map("topic_notes")
}

model TopicLesson {
  id              String   @id @default(cuid())
  topicId         String
  title           String
  position        Int      @default(0)
  videoUrl        String?
  durationMinutes Int?
  contentBody     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  topic      ExamTopic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progresses TopicLessonProgress[]
  curriculumActivities CurriculumActivity[]

  @@index([topicId])
  @@map("topic_lessons")
}

model TopicLessonProgress {
  id            String    @id @default(cuid())
  userId        String
  topicLessonId String
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicLesson TopicLesson @relation(fields: [topicLessonId], references: [id], onDelete: Cascade)

  @@unique([userId, topicLessonId])
  @@map("topic_lesson_progresses")
}

// ====================================================================
// IDENTITY & ACCESS
// ====================================================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String?
  name           String
  phone          String?
  nationalId     String?
  birthDate      DateTime?
  occupation     String?
  educationLevel String?
  role           UserRole  @default(STUDENT)
  image          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accessGrants AccessGrant[]
  subscriptions MembershipSubscription[]
  auditEvents CommercialAudit[]
  cohortMemberships CohortEnrollment[]
  cohortWaitlists CohortWaitlist[]
  teachingCohorts ProgrammeCohort[] @relation("CohortTeacher")
  verifiedActivities ActivityCompletion[] @relation("ActivityVerifier")
  orders               Order[]
  cart                 Cart?
  enrollments          Enrollment[]
  blogPosts            BlogPost[]
  topicLessonProgresses TopicLessonProgress[]
  topicNotes            TopicNote[]
  groupBookings GroupLessonEnrollment[]
  instructedSessions LiveSession[] @relation("SessionInstructor")

  @@map("users")
}

// ====================================================================
// CATALOG
// ====================================================================

model Product {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  subtitle         String?
  category         ProductCategory
  examTypeId       String?
  level            ProductLevel?
  posterImageUrl   String?
  badgeLabel       String?
  basePrice        Decimal         @db.Decimal(12, 2)
  salePrice        Decimal         @db.Decimal(12, 2)
  currency         String          @default("TRY")
  isPublished      Boolean         @default(true)
  isFeatured       Boolean         @default(false)
  displayOrder     Int             @default(0)
  shortDescription String?
  description      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  examType   ExamType? @relation(fields: [examTypeId], references: [id])
  course     Course?
  book       Book?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([category])
  @@index([examTypeId])
  @@map("products")
}

model Course {
  id               String                @id @default(cuid())
  productId        String                @unique
  deliveryFormat   CourseDeliveryFormat  @default(HYBRID)
  curriculumKey String? @unique
  curriculumTargetMinutes Int?
  curriculumPublishedAt DateTime?
  examFormatVerifiedAt DateTime?
  syllabusSummary  String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cohorts ProgrammeCohort[]
  modules      CourseModule[]
  liveSessions LiveSession[]
  enrollments  Enrollment[]

  @@map("courses")
}

model CourseModule {
  description String?
  id        String   @id @default(cuid())
  courseId  String
  title     String
  position  Int
  createdAt DateTime @default(now())

  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons RecordedLesson[]
  units CurriculumUnit[]
  durationBudgets ModuleDurationBudget[]

  @@unique([courseId, position])
  @@map("course_modules")
}

model RecordedLesson {
  id              String   @id @default(cuid())
  moduleId        String
  unitId          String?
  title           String
  position        Int
  videoUrl        String?
  durationMinutes Int?
  isPreviewable   Boolean  @default(false)
  description     String?

  module           CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonProgresses LessonProgress[]
  unit CurriculumUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  activities CurriculumActivity[]

  @@index([unitId])
  @@unique([moduleId, position])
  @@map("recorded_lessons")
}

model LiveSession {
  id            String   @id @default(cuid())
  courseId      String
  title         String
  cohortLabel   String?
  startsAt      DateTime
  endsAt        DateTime
  timezone      String   @default("Europe/Istanbul")
  meetingUrl    String?
  recordingUrl  String?
  capacity      Int? @default(10)
  createdAt     DateTime @default(now())

  availabilityEnabled Boolean @default(false)
  enrollmentOpen Boolean @default(true)
  cancelled Boolean @default(false)
  displayedOccupancy Int?
  useDisplayedOccupancy Boolean @default(false)
  adminNotes String?
  instructorId String?
  recurringSeriesId String?
  updatedAt DateTime @default(now()) @updatedAt
  instructor User? @relation("SessionInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  recurringSeries GroupLessonSeries? @relation(fields: [recurringSeriesId], references: [id], onDelete: SetNull)
  bookings GroupLessonEnrollment[]
  cohortId String?
  cohort ProgrammeCohort? @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  activityCompletions ActivityCompletion[]
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([cohortId], map: "live_sessions_cohort_id_idx")
  @@index([startsAt, availabilityEnabled])
  @@index([recurringSeriesId])
  @@index([courseId])
  @@map("live_sessions")
}

model Book {
  id             String     @id @default(cuid())
  productId      String     @unique
  author         String
  format         BookFormat @default(PDF)
  pageCount      Int?
  isbn           String?
  digitalFileUrl String?
  createdAt      DateTime   @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("books")
}

// ====================================================================
// ENROLLMENT & PROGRESS
// ====================================================================

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  orderItemId String?          @unique
  status      EnrollmentStatus @default(ACTIVE)
  grantedAt   DateTime         @default(now())
  expiresAt   DateTime?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderItem        OrderItem?        @relation(fields: [orderItemId], references: [id])
  lessonProgresses LessonProgress[]
  submissions      PracticeSubmission[]
  activityCompletions ActivityCompletion[]

  @@unique([userId, courseId])
  @@map("enrollments")
}

enum SubmissionStatus {
  PENDING
  REVIEWED
}

model PracticeSubmission {
  id              String           @id @default(cuid())
  enrollmentId    String
  title           String
  studentAnswer   String
  status          SubmissionStatus @default(PENDING)
  teacherFeedback String?
  score           Decimal?         @db.Decimal(5, 2)
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  activityCompletion ActivityCompletion?

  @@map("practice_submissions")
}

model LessonProgress {
  id               String    @id @default(cuid())
  enrollmentId     String
  recordedLessonId String
  completedAt      DateTime?

  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recordedLesson RecordedLesson @relation(fields: [recordedLessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, recordedLessonId])
  @@map("lesson_progress")
}

// ====================================================================
// COMMERCE
// ====================================================================

model Cart {
  id           String   @id @default(cuid())
  userId       String?  @unique
  sessionToken String?  @unique
  currency     String   @default("TRY")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  productId         String
  quantity          Int      @default(1)
  unitPriceSnapshot Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id             String      @id @default(cuid())
  userId         String?
  guestName      String?
  guestEmail     String?
  guestPhone     String?
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(12, 2)
  discountTotal  Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  currency       String      @default("TRY")
  commercialKind CommercialKind?
  checkoutKey String? @unique
  reservation SeatReservation?
  couponCode     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user    User?       @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@map("orders")
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  value           Decimal    @db.Decimal(12, 2)
  description     String?
  isActive        Boolean    @default(true)
  isPublic        Boolean    @default(false)
  minOrderAmount  Decimal?   @db.Decimal(12, 2)
  maxRedemptions  Int?
  redemptionCount Int        @default(0)
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())

  @@map("coupons")
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String
  purchaseType PurchaseType @default(LEGACY)
  billingInterval BillingInterval?
  cohortId String?
  cohort ProgrammeCohort? @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  periodStartsAt DateTime?
  paidThrough DateTime?
  accessExpiresAt DateTime?
  titleSnapshot String
  unitPrice     Decimal  @db.Decimal(12, 2)
  quantity      Int      @default(1)
  lineTotal     Decimal  @db.Decimal(12, 2)

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id])
  accessGrants AccessGrant[]
  cohortEnrollment CohortEnrollment?
  subscription MembershipSubscription?
  enrollment Enrollment?

  @@index([cohortId])
  @@map("order_items")
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String        @unique
  provider   String        @default("MANUAL")
  providerRef String?
  amount     Decimal       @db.Decimal(12, 2)
  currency   String        @default("TRY")
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ====================================================================
// CONTENT & MARKETING
// ====================================================================

model Testimonial {
  id             String   @id @default(cuid())
  studentName    String
  studentPhotoUrl String?
  examTypeId     String?
  resultSummary  String?
  quote          String
  rating         Int      @default(5)
  isPublished    Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())

  examType ExamType? @relation(fields: [examTypeId], references: [id])

  @@map("testimonials")
}

model BlogCategory {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  displayOrder Int      @default(0)
  active       Boolean  @default(true)

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  excerpt        String
  content        String
  coverImageUrl  String?
  authorId       String
  categoryId     String?
  tags           String[]       @default([])
  status         BlogPostStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  author   User          @relation(fields: [authorId], references: [id])
  category BlogCategory? @relation(fields: [categoryId], references: [id])

  @@map("blog_posts")
}

// ====================================================================
// FREE TOOLS & RESOURCES
// ====================================================================

model DictionaryTerm {
  id              String  @id @default(cuid())
  term            String
  definition      String
  exampleSentence String?
  examTypeId      String?

  examType ExamType? @relation(fields: [examTypeId], references: [id])

  @@index([term])
  @@map("dictionary_terms")
}

model ScoreConversionEntry {
  id           String @id @default(cuid())
  examTypeId   String
  inputLabel   String
  resultLabel  String
  notes        String?
  minCorrect   Int
  maxCorrect   Int
  displayOrder Int    @default(0)

  examType ExamType @relation(fields: [examTypeId], references: [id], onDelete: Cascade)

  @@map("score_conversion_entries")
}

model ExamCalendarEntry {
  id                  String    @id @default(cuid())
  examTypeId          String
  title               String?
  examDate            DateTime
  applicationDeadline DateTime?
  resultDate          DateTime?
  year                Int

  examType ExamType @relation(fields: [examTypeId], references: [id], onDelete: Cascade)

  @@map("exam_calendar_entries")
}

model FreeResource {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String?
  fileUrl       String
  examTypeId    String?
  category      String?
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())

  examType ExamType? @relation(fields: [examTypeId], references: [id])

  curriculumActivities CurriculumActivity[]

  @@map("free_resources")
}

// ====================================================================
// LEAD GENERATION
// ====================================================================

model CallbackRequest {
  id          String                @id @default(cuid())
  name        String
  phone       String
  note        String?
  examTypeId  String?
  status      CallbackRequestStatus @default(NEW)
  contactedAt DateTime?
  createdAt   DateTime              @default(now())

  examType ExamType? @relation(fields: [examTypeId], references: [id])

  @@map("callback_requests")
}

model GroupLessonSeries {
 id String @id @default(cuid())
 repeatUntil DateTime
 createdAt DateTime @default(now())
 sessions LiveSession[]
 @@map("group_lesson_series")
}
enum GroupBookingStatus {
 ACTIVE
 CANCELLED
}
model GroupLessonEnrollment {
 id String @id @default(cuid())
 slotId String
 studentId String
 status GroupBookingStatus @default(ACTIVE)
 enrolledAt DateTime @default(now())
 cancelledAt DateTime?
 slot LiveSession @relation(fields: [slotId], references: [id], onDelete: Restrict)
 student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
 @@unique([slotId, studentId])
 @@index([slotId, status])
 @@map("group_lesson_enrollments")
}

// Commercial foundation. Amounts are integer kuruş; payment periods never define curriculum length.
enum BillingInterval {
 MONTHLY
 QUARTERLY
 SIX_MONTH
 ANNUAL
}
enum CommercialKind {
 PREMIUM
 GROUP
}
enum ToolAccessPolicy {
 FREE
 PREMIUM
 GROUP_INCLUDED
 SEPARATE_PURCHASE
}
enum Capability {
 FREE_CONTENT
 PREMIUM_SIMULATIONS
 QUESTION_BANK
 PERFORMANCE_ANALYTICS
 STUDY_TOOLS
 DIGITAL_RESOURCES
 HOMEWORK
 TEACHER_FEEDBACK
 GROUP_LESSONS
 GROUP_FULL_ACCESS
}
model CommercialPrice {
 id String @id @default(cuid())
 kind CommercialKind
 interval BillingInterval
 amountMinor Int
 currency String @default("TRY")
 active Boolean @default(true)
 checkoutEnabled Boolean @default(false)
 updatedAt DateTime @updatedAt
 @@unique([kind, interval])
 @@map("commercial_prices")
}
model LearningTool {
 key String @id
 name String
 policy ToolAccessPolicy @default(SEPARATE_PURCHASE)
 enabled Boolean @default(false)
 @@map("learning_tools")
}
model MembershipSubscription {
 id String @id @default(cuid())
 userId String
 orderItemId String @unique
 interval BillingInterval
 startsAt DateTime
 expiresAt DateTime
 revokedAt DateTime?
 user User @relation(fields: [userId], references: [id], onDelete: Restrict)
 orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
 @@index([userId, expiresAt])
 @@map("membership_subscriptions")
}
model AccessGrant {
 id String @id @default(cuid())
 userId String
 orderItemId String
 capability Capability
 startsAt DateTime
 expiresAt DateTime
 revokedAt DateTime?
 user User @relation(fields: [userId], references: [id], onDelete: Restrict)
 orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
 @@unique([orderItemId, capability])
 @@index([userId, expiresAt])
 @@map("access_grants")
}
model CommercialAudit {
 id String @id @default(cuid())
 actorId String
 action String
 targetId String
 details Json
 createdAt DateTime @default(now())
 actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
 @@index([targetId, createdAt])
 @@map("commercial_audit")
}

// Structured programmes extend existing courses and lessons; billing is independent.
enum CurriculumActivityType {
 LIVE_INSTRUCTION
 GUIDED_PRACTICE
 EXAM_SIMULATION
 INDEPENDENT_STUDY
 REVIEW_ASSESSMENT
}
model ModuleDurationBudget {
 id String @id @default(cuid())
 moduleId String
 type CurriculumActivityType
 minutes Int
 module CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
 @@unique([moduleId, type])
 @@map("module_duration_budgets")
}
model CurriculumUnit {
 id String @id @default(cuid())
 moduleId String
 title String
 objective String
 position Int
 module CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
 lessons RecordedLesson[]
 @@unique([moduleId, position])
 @@map("curriculum_units")
}
model CurriculumActivity {
 id String @id @default(cuid())
 lessonId String
 title String
 position Int
 type CurriculumActivityType
 durationMinutes Int
 instructions String
 completionCriteria String
 topicLessonId String?
 freeResourceId String?
 // Identifies a verified server-side simulation adapter; empty until one exists.
 simulationKey String?
 lesson RecordedLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
 topicLesson TopicLesson? @relation(fields: [topicLessonId], references: [id], onDelete: Restrict)
 freeResource FreeResource? @relation(fields: [freeResourceId], references: [id], onDelete: Restrict)
 assessment ActivityAssessment?
 prerequisites ActivityPrerequisite[] @relation("ActivityPrerequisites")
 dependents ActivityPrerequisite[] @relation("ActivityDependents")
 completions ActivityCompletion[]
 @@unique([lessonId, position])
 @@index([topicLessonId])
 @@index([freeResourceId])
 @@map("curriculum_activities")
}
model ActivityAssessment {
 id String @id @default(cuid())
 activityId String @unique
 rubric String
 minimumScore Int?
 activity CurriculumActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
 @@map("activity_assessments")
}
model ActivityPrerequisite {
 activityId String
 prerequisiteId String
 activity CurriculumActivity @relation("ActivityPrerequisites", fields: [activityId], references: [id], onDelete: Cascade)
 prerequisite CurriculumActivity @relation("ActivityDependents", fields: [prerequisiteId], references: [id], onDelete: Restrict)
 @@id([activityId, prerequisiteId])
 @@index([prerequisiteId])
 @@map("activity_prerequisites")
}
model ActivityCompletion {
 id String @id @default(cuid())
 enrollmentId String
 activityId String
 verifiedById String
 completedAt DateTime @default(now())
 // Immutable credit snapshot, never client-supplied or derived from calendar time.
 creditedMinutes Int
 evidenceNote String
 submissionId String? @unique
 liveSessionId String?
 revokedAt DateTime?
 enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
 activity CurriculumActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)
 verifiedBy User @relation("ActivityVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
 submission PracticeSubmission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)
 liveSession LiveSession? @relation(fields: [liveSessionId], references: [id], onDelete: Restrict)
 @@unique([enrollmentId, activityId])
 @@unique([enrollmentId, liveSessionId])
 @@index([activityId])
 @@index([verifiedById])
 @@map("activity_completions")
}


enum CohortStatus {
 DRAFT
 OPEN
 CLOSED
 CANCELLED
 ARCHIVED
}
enum CohortEnrollmentStatus {
 PENDING
 CONFIRMED
 CANCELLED
}
enum CohortWaitlistStatus {
 WAITING
 ENROLLED
 CANCELLED
}
model ProgrammeCohort {
 id String @id @default(cuid())
 courseId String
 teacherId String
 title String
 startsAt DateTime
 expectedEndsAt DateTime
 timezone String @default("Europe/Istanbul")
 minimumCapacity Int @default(5)
 maximumCapacity Int @default(10)
 graceDays Int @default(0)
 seatHoldMinutes Int @default(1440)
 salesEnabled Boolean @default(false)
