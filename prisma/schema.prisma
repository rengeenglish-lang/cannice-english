generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ====================================================================
// ENUMS
// ====================================================================

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum ExamCode {
  IELTS
  TOEFL
  PTE
  YDS
  YOKDIL_SOSYAL
  YOKDIL_SAGLIK
  YOKDIL_FEN
}

enum ProductCategory {
  PREP_GROUP
  MOCK_CAMP
  STUDY_PACKAGE
  TRANSLATION_SUPPORT
  BOOK
  PLAN
}

/**
 * Deneme Sınavı subscription tiers (Başlangıç / Çırak / Uzman). Which features each tier unlocks
 * lives in lib/plans.ts — the single place site-wide access checks read from.
 */
enum PlanTier {
  BASLANGIC
  CIRAK
  UZMAN
}

/**
 * The three free live-lesson perks bundled into the Uzman plan, each claimable once per subscription.
 */
enum PlanPerk {
  SPEAKING_CLUB
  SYSTEMATIC_LIVE
  ELECTIVE_LIVE
}

/**
 * Which Kaynaklar hub section a FreeResource is listed under.
 */
enum ResourceKind {
  E_BOOK
  TOPIC
  PDF_MOCK
}

enum ProductLevel {
  BEGINNER_TO_ADVANCED
  INTERMEDIATE_ADVANCED
  JUNIOR
  SENIOR
}

enum CourseDeliveryFormat {
  HYBRID
  RECORDED_ONLY
  LIVE_ONLY
}

enum BookFormat {
  PDF
  PRINT
  PRINT_AND_PDF
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum CallbackRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

// ====================================================================
// DIAGNOSTIC / PERSONALIZED PREP JOURNEY ENUMS
// ====================================================================

enum ExamFamily {
  ACADEMIC_SKILLS
  TRANSLATION_GRAMMAR
}

enum GoalTimeframe {
  EXACT_DATE
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  UNKNOWN
}

enum DiagnosticTopicKind {
  SKILL
  SUBSKILL
  TOPIC
}

enum DiagnosticQuestionType {
  MCQ
  LISTENING_MCQ
  CLOZE
  TRANSLATION_EN_TR
  TRANSLATION_TR_EN
  SENTENCE_COMPLETION
  PARAGRAPH_COMPLETION
  READING_COMPREHENSION
  RESTATEMENT
  WRITING_TASK
  SPEAKING_TASK
}

enum DiagnosticDifficulty {
  KOLAY
  ORTA
  ZOR
}

enum DiagnosticAttemptKind {
  FULL_DIAGNOSTIC
  MASTERY_CHECK
  PRACTICE
  MOCK_EXAM
}

enum DiagnosticAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum DiagnosticSeverity {
  CRITICAL
  NEEDS_IMPROVEMENT
  DEVELOPING
  STRONG
}

enum RoadmapItemStatus {
  NOT_STARTED
  IN_PROGRESS
  MASTERY_CHECK_REQUIRED
  COMPLETED
}

// ====================================================================
// REFERENCE DATA
// ====================================================================

model ExamType {
  id               String   @id @default(cuid())
  code             ExamCode @unique
  slug             String   @unique
  name             String
  shortDescription String?
  iconKey          String?
  displayOrder     Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products            Product[]
  testimonials        Testimonial[]
  dictionaryTerms     DictionaryTerm[]
  scoreConversionRows ScoreConversionEntry[]
  calendarEntries     ExamCalendarEntry[]
  freeResources       FreeResource[]
  callbackRequests    CallbackRequest[]
  topics              ExamTopic[]
  examGoals           ExamGoal[]
  diagnosticAttempts  DiagnosticAttempt[]
  diagnosticQuestions DiagnosticQuestion[]
  diagnosticTopics    DiagnosticTopic[]

  @@map("exam_types")
}

// ====================================================================
// KONU ANLATIM (FREE TOPIC LEARNING DASHBOARD)
// ====================================================================

model ExamTopic {
  id            String   @id @default(cuid())
  examTypeId    String
  name          String
  slug          String
  description   String?
  questionCount Int?
  category      String?
  skillsTested  String?
  difficulty    String?
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examType       ExamType         @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  lessons        TopicLesson[]
  notes          TopicNote[]
  savedBy        SavedExamTopic[]
  studyGoalItems StudyGoalItem[]

  @@unique([examTypeId, slug])
  @@index([examTypeId])
  @@map("exam_topics")
}

model TopicNote {
  id          String   @id @default(cuid())
  userId      String
  examTopicId String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic ExamTopic @relation(fields: [examTopicId], references: [id], onDelete: Cascade)

  @@unique([userId, examTopicId])
  @@map("topic_notes")
}

model TopicLesson {
  id                 String   @id @default(cuid())
  topicId            String
  title              String
  position           Int      @default(0)
  videoUrl           String?
  durationMinutes    Int?
  contentBody        String?
  diagnosticTopicIds String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  topic      ExamTopic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progresses TopicLessonProgress[]

  @@index([topicId])
  @@index([diagnosticTopicIds], type: Gin)
  @@map("topic_lessons")
}

model TopicLessonProgress {
  id            String    @id @default(cuid())
  userId        String
  topicLessonId String
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicLesson TopicLesson @relation(fields: [topicLessonId], references: [id], onDelete: Cascade)

  @@unique([userId, topicLessonId])
  @@map("topic_lesson_progresses")
}

// ====================================================================
// IDENTITY & ACCESS
// ====================================================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String?
  name           String
  phone          String?
  nationalId     String?
  birthDate      DateTime?
  occupation     String?
  educationLevel String?
  role           UserRole  @default(STUDENT)
  image          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders                Order[]
  cart                  Cart?
  enrollments           Enrollment[]
  blogPosts             BlogPost[]
  topicLessonProgresses TopicLessonProgress[]
  topicNotes            TopicNote[]
  groupBookings         GroupLessonEnrollment[]
  instructedSessions    LiveSession[]             @relation("SessionInstructor")
  examGoals             ExamGoal[]
  diagnosticAttempts    DiagnosticAttempt[]
  studyRoadmapItems     StudyRoadmapItem[]
  analyticsEvents       AnalyticsEvent[]
  notifications         Notification[]
  reviews               Review[]
  planSubscriptions     PlanSubscription[]
  savedExamTopics       SavedExamTopic[]
  visits                UserVisit[]
  favorites             FavoriteProduct[]
  coachingProfile       CoachingProfile?
  studyPlanWeeks        StudyPlanWeek[]
  studyTasks            StudyTask[]
  planProposals         PlanProposal[]
  vocabCards            VocabCard[]
  mistakeEntries        MistakeEntry[]
  coachingCheckIns      CoachingCheckIn[]
  coachingFeedback      CoachingFeedback[]
  coachingReports       CoachingReport[]
  coachingNotifications CoachingNotificationLog[]
  lexiconWords          LexiconWordState[]
  lexiconTests          LexiconSetTest[]
  sentMessages          TeacherMessage[]          @relation("MessageStudent")
  answeredMessages      TeacherMessage[]          @relation("MessageResponder")
  studyGoals            StudyGoal[]

  @@map("users")
}

/**
 * In-app notification center — there is no transactional email system (see .env.example), so this
 * is currently the only way a student learns that an order/payment status changed or a Writing
 * submission was graded, short of checking the relevant page themselves.
 */
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

/**
 * A student's own rating/review of a product they bought — distinct from the admin-curated Testimonial model shown on marketing pages.
 */
model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

// ====================================================================
// CATALOG
// ====================================================================

model Product {
  id                 String          @id @default(cuid())
  slug               String          @unique
  title              String
  subtitle           String?
  category           ProductCategory
  examTypeId         String?
  level              ProductLevel?
  posterImageUrl     String?
  badgeLabel         String?
  basePrice          Decimal         @db.Decimal(12, 2)
  salePrice          Decimal         @db.Decimal(12, 2)
  currency           String          @default("TRY")
  isPublished        Boolean         @default(true)
  isFeatured         Boolean         @default(false)
  displayOrder       Int             @default(0)
  shortDescription   String?
  description        String?
  diagnosticTopicIds String[]        @default([])
  /**
   * Set only for category PLAN.
   */
  planTier           PlanTier?
  /**
   * Plan length in calendar months (PLAN only), so "1 aylık" is 30 or 31 days depending on the month.
   */
  accessMonths       Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  examType    ExamType?         @relation(fields: [examTypeId], references: [id])
  course      Course?
  book        Book?
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
  favoritedBy FavoriteProduct[]

  @@index([category])
  @@index([examTypeId])
  @@index([diagnosticTopicIds], type: Gin)
  @@map("products")
}

model Course {
  id              String               @id @default(cuid())
  productId       String               @unique
  deliveryFormat  CourseDeliveryFormat @default(HYBRID)
  syllabusSummary String?
  /**
   * Konuşma kulübü groups — the only courses the Uzman plan's SPEAKING_CLUB perk can be claimed on.
   */
  isSpeakingClub  Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  modules      CourseModule[]
  liveSessions LiveSession[]
  enrollments  Enrollment[]
  perkClaims   PlanPerkClaim[]
  messages     TeacherMessage[]

  @@map("courses")
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  position  Int
  createdAt DateTime @default(now())

  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons RecordedLesson[]

  @@unique([courseId, position])
  @@map("course_modules")
}

model RecordedLesson {
  id              String  @id @default(cuid())
  moduleId        String
  title           String
  position        Int
  videoUrl        String?
  durationMinutes Int?
  isPreviewable   Boolean @default(false)
  description     String?

  module           CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonProgresses LessonProgress[]

  @@unique([moduleId, position])
  @@map("recorded_lessons")
}

model LiveSession {
  id           String   @id @default(cuid())
  courseId     String
  title        String
  cohortLabel  String?
  startsAt     DateTime
  endsAt       DateTime
  timezone     String   @default("Europe/Istanbul")
  meetingUrl   String?
  recordingUrl String?
  capacity     Int?     @default(10)
  createdAt    DateTime @default(now())

  availabilityEnabled   Boolean                 @default(false)
  enrollmentOpen        Boolean                 @default(true)
  cancelled             Boolean                 @default(false)
  displayedOccupancy    Int?
  useDisplayedOccupancy Boolean                 @default(false)
  adminNotes            String?
  instructorId          String?
  recurringSeriesId     String?
  updatedAt             DateTime                @default(now()) @updatedAt
  instructor            User?                   @relation("SessionInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  recurringSeries       GroupLessonSeries?      @relation(fields: [recurringSeriesId], references: [id], onDelete: SetNull)
  bookings              GroupLessonEnrollment[]
  course                Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([startsAt, availabilityEnabled])
  @@index([recurringSeriesId])
  @@index([courseId])
  @@map("live_sessions")
}

model Book {
  id             String     @id @default(cuid())
  productId      String     @unique
  author         String
  format         BookFormat @default(PDF)
  pageCount      Int?
  isbn           String?
  digitalFileUrl String?
  createdAt      DateTime   @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("books")
}

// ====================================================================
// ENROLLMENT & PROGRESS
// ====================================================================

model Enrollment {
  id                  String           @id @default(cuid())
  userId              String
  courseId            String
  orderItemId         String?          @unique
  status              EnrollmentStatus @default(ACTIVE)
  grantedAt           DateTime         @default(now())
  expiresAt           DateTime?
  /**
   * Monthly-billed group lessons (PREP_GROUP) only: the end of the paid billing month. When it
   * passes the student is notified; one day later live-lesson access locks until they renew.
   * Null = not billed monthly (legacy enrollments and every non-group course keep working as-is).
   */
  paidThrough         DateTime?
  /**
   * Set once the "payment due" notification for the current paidThrough has been sent.
   */
  renewalNoticeSentAt DateTime?

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderItem        OrderItem?           @relation(fields: [orderItemId], references: [id])
  lessonProgresses LessonProgress[]
  submissions      PracticeSubmission[]

  @@unique([userId, courseId])
  @@map("enrollments")
}

enum SubmissionStatus {
  PENDING
  REVIEWED
}

model PracticeSubmission {
  id              String           @id @default(cuid())
  enrollmentId    String
  title           String
  studentAnswer   String
  status          SubmissionStatus @default(PENDING)
  teacherFeedback String?
  score           Decimal?         @db.Decimal(5, 2)
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("practice_submissions")
}

model LessonProgress {
  id               String    @id @default(cuid())
  enrollmentId     String
  recordedLessonId String
  completedAt      DateTime?

  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recordedLesson RecordedLesson @relation(fields: [recordedLessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, recordedLessonId])
  @@map("lesson_progress")
}

// ====================================================================
// COMMERCE
// ====================================================================

model Cart {
  id           String   @id @default(cuid())
  userId       String?  @unique
  sessionToken String?  @unique
  currency     String   @default("TRY")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  productId         String
  quantity          Int      @default(1)
  unitPriceSnapshot Decimal  @db.Decimal(12, 2)
  /**
   * The group-lesson slot a "Gruba Katıl" purchase should book once payment is confirmed.
   */
  groupSlotId       String?
  createdAt         DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(12, 2)
  discountTotal   Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  currency        String      @default("TRY")
  couponCode      String?
  /// When the buyer ticked the Ön Bilgilendirme Formu + Mesafeli Satış Sözleşmesi box at checkout.
  termsAcceptedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user    User?       @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@map("orders")
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  value           Decimal    @db.Decimal(12, 2)
  description     String?
  isActive        Boolean    @default(true)
  isPublic        Boolean    @default(false)
  minOrderAmount  Decimal?   @db.Decimal(12, 2)
  maxRedemptions  Int?
  redemptionCount Int        @default(0)
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())

  @@map("coupons")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  titleSnapshot String
  unitPrice     Decimal @db.Decimal(12, 2)
  quantity      Int     @default(1)
  lineTotal     Decimal @db.Decimal(12, 2)
  groupSlotId   String?

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  enrollment       Enrollment?
  planSubscription PlanSubscription?

  @@map("order_items")
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  provider    String        @default("MANUAL")
  providerRef String?
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("TRY")
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ====================================================================
// CONTENT & MARKETING
// ====================================================================

model Testimonial {
  id              String   @id @default(cuid())
  studentName     String
  studentPhotoUrl String?
  examTypeId      String?
  resultSummary   String?
  quote           String
  rating          Int      @default(5)
  isPublished     Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())

  examType ExamType? @relation(fields: [examTypeId], references: [id])

  @@map("testimonials")
}

model BlogCategory {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  excerpt        String
  content        String
  coverImageUrl  String?
  authorId       String
  categoryId     String?
  tags           String[]       @default([])
  status         BlogPostStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  author   User          @relation(fields: [authorId], references: [id])
  category BlogCategory? @relation(fields: [categoryId], references: [id])

  @@map("blog_posts")
}

// ====================================================================
// FREE TOOLS & RESOURCES
// ====================================================================

model DictionaryTerm {
  id              String  @id @default(cuid())
  term            String
  definition      String
  exampleSentence String?
  examTypeId      String?

  examType ExamType? @relation(fields: [examTypeId], references: [id])

  @@index([term])
  @@map("dictionary_terms")
}

model ScoreConversionEntry {
  id           String  @id @default(cuid())
  examTypeId   String
  inputLabel   String
  resultLabel  String
  notes        String?
  minCorrect   Int
  maxCorrect   Int
  displayOrder Int     @default(0)

  examType ExamType @relation(fields: [examTypeId], references: [id], onDelete: Cascade)

  @@map("score_conversion_entries")
}

model ExamCalendarEntry {
  id                  String    @id @default(cuid())
  examTypeId          String
  title               String?
  examDate            DateTime
  applicationDeadline DateTime?
  resultDate          DateTime?
  year                Int

  examType ExamType @relation(fields: [examTypeId], references: [id], onDelete: Cascade)

  @@map("exam_calendar_entries")
}

model FreeResource {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String?
  fileUrl       String
  examTypeId    String?
  category      String?
  kind          ResourceKind?
  downloadCount Int           @default(0)
  createdAt     DateTime      @default(now())

  examType ExamType? @relation(fields: [examTypeId], references: [id])

  @@map("free_resources")
}

// ====================================================================
// LEAD GENERATION
// ====================================================================

model CallbackRequest {
  id          String                @id @default(cuid())
  name        String
  phone       String
  note        String?
  examTypeId  String?
  status      CallbackRequestStatus @default(NEW)
  contactedAt DateTime?
  createdAt   DateTime              @default(now())

  examType ExamType? @relation(fields: [examTypeId], references: [id])

  @@map("callback_requests")
}

model GroupLessonSeries {
  id          String        @id @default(cuid())
  repeatUntil DateTime
  createdAt   DateTime      @default(now())
  sessions    LiveSession[]

  @@map("group_lesson_series")
}

enum GroupBookingStatus {
  ACTIVE
  CANCELLED
}

model GroupLessonEnrollment {
  id          String             @id @default(cuid())
  slotId      String
  studentId   String
  status      GroupBookingStatus @default(ACTIVE)
  enrolledAt  DateTime           @default(now())
  cancelledAt DateTime?
  slot        LiveSession        @relation(fields: [slotId], references: [id], onDelete: Restrict)
  student     User               @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([slotId, studentId])
  @@index([slotId, status])
  @@map("group_lesson_enrollments")
}

// ====================================================================
// PERSONALIZED PREP JOURNEY (GOAL → DIAGNOSTIC → ROADMAP)
// ====================================================================

model ExamGoal {
  id                String        @id @default(cuid())
  userId            String
  examTypeId        String
  currentScoreRaw   String?
  currentScoreKnown Boolean       @default(false)
  targetScoreRaw    String
  targetTimeframe   GoalTimeframe @default(UNKNOWN)
  targetDate        DateTime?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  examType     ExamType            @relation(fields: [examTypeId], references: [id])
  attempts     DiagnosticAttempt[]
  roadmapItems StudyRoadmapItem[]

  @@index([userId, examTypeId, isActive])
  @@map("exam_goals")
}

model DiagnosticTopic {
  id               String              @id @default(cuid())
  slug             String              @unique
  name             String
  kind             DiagnosticTopicKind
  examFamilies     ExamFamily[]
  /**
   * Null = shared across every exam in examFamilies (how YDS/YÖKDİL topics work — one grammar
   * pool for the whole TRANSLATION_GRAMMAR family). Set = scoped to one specific exam, needed for
   * ACADEMIC_SKILLS where IELTS/TOEFL/PTE each have their own distinct Reading question formats
   * that must not mix.
   */
  examTypeId       String?
  parentTopicId    String?
  importanceWeight Int                 @default(1)
  estimatedMinutes Int?
  description      String?
  displayOrder     Int                 @default(0)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  parent   DiagnosticTopic?  @relation("TopicHierarchy", fields: [parentTopicId], references: [id], onDelete: SetNull)
  children DiagnosticTopic[] @relation("TopicHierarchy")
  examType ExamType?         @relation(fields: [examTypeId], references: [id], onDelete: Cascade)

  primaryQuestions DiagnosticQuestion[]    @relation("PrimaryTopic")
  topicResults     DiagnosticTopicResult[]
  roadmapItems     StudyRoadmapItem[]
  dependsOn        TopicDependency[]       @relation("TopicDependents")
  dependents       TopicDependency[]       @relation("TopicPrerequisites")

  @@index([kind])
  @@index([parentTopicId])
  @@index([examTypeId])
  @@map("diagnostic_topics")
}

model TopicDependency {
  id               String @id @default(cuid())
  topicId          String
  dependsOnTopicId String

  topic          DiagnosticTopic @relation("TopicDependents", fields: [topicId], references: [id], onDelete: Cascade)
  dependsOnTopic DiagnosticTopic @relation("TopicPrerequisites", fields: [dependsOnTopicId], references: [id], onDelete: Cascade)

  @@unique([topicId, dependsOnTopicId])
  @@map("topic_dependencies")
}

model DiagnosticQuestion {
  id                String                 @id @default(cuid())
  examFamily        ExamFamily
  examTypeId        String?
  topicId           String
  secondaryTopicIds String[]               @default([])
  questionType      DiagnosticQuestionType
  difficulty        DiagnosticDifficulty   @default(ORTA)
  prompt            String
  passageText       String?
  audioUrl          String?
  options           Json?
  correctAnswer     String?
  explanation       String?
  tags              String[]               @default([])
  isActive          Boolean                @default(false)
  /**
   * 1-5 — pins this question into a fixed "Deneme N" mock-exam paper instead of the general
   * full-diagnostic/practice/mastery-check pool. Null means "general pool, not a mock paper".
   */
  mockSetNumber     Int?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  examType  ExamType?            @relation(fields: [examTypeId], references: [id])
  topic     DiagnosticTopic      @relation("PrimaryTopic", fields: [topicId], references: [id], onDelete: Restrict)
  responses DiagnosticResponse[]

  @@index([examFamily, topicId, isActive])
  @@index([examTypeId])
  @@index([examTypeId, mockSetNumber])
  @@map("diagnostic_questions")
}

model DiagnosticAttempt {
  id            String                  @id @default(cuid())
  userId        String
  examTypeId    String
  examFamily    ExamFamily
  kind          DiagnosticAttemptKind   @default(FULL_DIAGNOSTIC)
  scopeTopicId  String?
  /**
   * Which fixed "Deneme N" paper this MOCK_EXAM attempt drew from; null for every other kind.
   */
  mockSetNumber Int?
  goalId        String?
  status        DiagnosticAttemptStatus @default(IN_PROGRESS)
  questionOrder String[]
  currentIndex  Int                     @default(0)
  startedAt     DateTime                @default(now())
  completedAt   DateTime?
  createdAt     DateTime                @default(now())

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  examType     ExamType                @relation(fields: [examTypeId], references: [id])
  goal         ExamGoal?               @relation(fields: [goalId], references: [id], onDelete: SetNull)
  responses    DiagnosticResponse[]
  topicResults DiagnosticTopicResult[]

  @@index([userId, examTypeId, status])
  @@index([goalId])
  @@map("diagnostic_attempts")
}

model DiagnosticResponse {
  id              String            @id @default(cuid())
  attemptId       String
  questionId      String
  answerRaw       String?
  isCorrect       Boolean?
  gradingStatus   SubmissionStatus?
  teacherFeedback String?
  score           Decimal?          @db.Decimal(5, 2)
  reviewedAt      DateTime?
  answeredAt      DateTime          @default(now())

  attempt  DiagnosticAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question DiagnosticQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@map("diagnostic_responses")
}

model DiagnosticTopicResult {
  id                String             @id @default(cuid())
  attemptId         String
  userId            String
  topicId           String
  questionsAnswered Int
  questionsCorrect  Int
  accuracy          Float
  severity          DiagnosticSeverity
  createdAt         DateTime           @default(now())

  attempt DiagnosticAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  topic   DiagnosticTopic   @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@unique([attemptId, topicId])
  @@index([userId, topicId, createdAt])
  @@map("diagnostic_topic_results")
}

model StudyRoadmapItem {
  id                 String             @id @default(cuid())
  userId             String
  goalId             String
  topicId            String
  priorityRank       Int
  severityAtCreation DiagnosticSeverity
  status             RoadmapItemStatus  @default(NOT_STARTED)
  sourceAttemptId    String?
  createdAt          DateTime           @default(now())
  startedAt          DateTime?
  completedAt        DateTime?

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal  ExamGoal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  topic DiagnosticTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@unique([userId, goalId, topicId])
  @@index([userId, goalId, priorityRank])
  @@map("study_roadmap_items")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ====================================================================
// PLANS, SAVED TOPICS, MESSAGING, VISIT TRACKING
// ====================================================================

model PlanSubscription {
  id          String           @id @default(cuid())
  userId      String
  tier        PlanTier
  orderItemId String?          @unique
  status      EnrollmentStatus @default(ACTIVE)
  startsAt    DateTime         @default(now())
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem  OrderItem?      @relation(fields: [orderItemId], references: [id])
  perkClaims PlanPerkClaim[]

  @@index([userId, status, expiresAt])
  @@map("plan_subscriptions")
}

model PlanPerkClaim {
  id             String   @id @default(cuid())
  subscriptionId String
  perk           PlanPerk
  courseId       String
  claimedAt      DateTime @default(now())

  subscription PlanSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, perk])
  @@map("plan_perk_claims")
}

/**
 * A Konu Anlatımı topic the student added to Derslerim via "Ders Ekle".
 */
model SavedExamTopic {
  id          String   @id @default(cuid())
  userId      String
  examTopicId String
  createdAt   DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic ExamTopic @relation(fields: [examTopicId], references: [id], onDelete: Cascade)

  @@unique([userId, examTopicId])
  @@map("saved_exam_topics")
}

/**
 * "Öğretmenine mesaj gönder" — a student question to the teaching staff, answered from /admin/mesajlar.
 */
model TeacherMessage {
  id          String    @id @default(cuid())
  studentId   String
  courseId    String?
  body        String
  reply       String?
  repliedById String?
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())

  student   User    @relation("MessageStudent", fields: [studentId], references: [id], onDelete: Cascade)
  repliedBy User?   @relation("MessageResponder", fields: [repliedById], references: [id], onDelete: SetNull)
  course    Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([repliedAt])
  @@map("teacher_messages")
}

/**
 * One row per student per (Europe/Istanbul) calendar day they used the site — powers İlerleme Raporu's visit frequency.
 */
model UserVisit {
  id        String   @id @default(cuid())
  userId    String
  day       DateTime @db.Date
  pageViews Int      @default(1)
  lastSeen  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("user_visits")
}

/**
 * Favorilerim — products a student saved for later (heart button, or "Favorilere taşı" from the cart).
 */
model FavoriteProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorite_products")
}

enum StudyGoalPeriod {
  DAY
  WEEK
  MONTH
}

enum StudyGoalStatus {
  ACTIVE
  REACHED
  FAILED
}

enum StudyGoalItemKind {
  TOPIC
  PRACTICE
  MOCK_EXAM
  CUSTOM
}

/// A student-set study goal for a day/week/month, e.g. "3 topics + 1 deneme this week".
/// Not tied to a specific exam (a student may be preparing for more than one) - the topic
/// picker in the UI just defaults to their active ExamGoal's exam for convenience.
model StudyGoal {
  id            String          @id @default(cuid())
  userId        String
  period        StudyGoalPeriod
  periodStart   DateTime
  periodEnd     DateTime
  status        StudyGoalStatus @default(ACTIVE)
  reachedAt     DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items StudyGoalItem[]

  @@index([userId, period, periodStart])
  @@index([userId, status])
  @@map("study_goals")
}

/// One line item within a StudyGoal: a specific topic, N practice sets, N deneme (mock exams),
/// or a freeform line the student typed themselves.
model StudyGoalItem {
  id          String            @id @default(cuid())
  studyGoalId String
  kind        StudyGoalItemKind
  examTopicId String?
  quantity    Int?
  label       String?
  createdAt   DateTime          @default(now())

  studyGoal StudyGoal  @relation(fields: [studyGoalId], references: [id], onDelete: Cascade)
  examTopic ExamTopic? @relation(fields: [examTopicId], references: [id], onDelete: SetNull)

  @@index([studyGoalId])
  @@map("study_goal_items")
}

// ====================================================================
// ÜCRETSİZ ÖĞRENCİ KOÇLUĞU (free, automated English exam coaching)
// ====================================================================

/**
 * Coaching pathways. Versions (IELTS Academic/General, e-YDS, YÖKDİL branch...) live in lib/coaching/exams.ts.
 */
enum CoachingPathway {
  IELTS
  TOEFL
  PTE
  YDS
  YOKDIL
  YDT
}

enum StudyTaskKind {
  LESSON
  PRACTICE
  TIMED_PRACTICE
  MOCK
  LEVEL_TEST
  VOCAB_REVIEW
  MISTAKE_REVIEW
  SPEAKING
  WRITING
  LISTENING
  READING
  CUSTOM
}

enum StudyTaskStatus {
  PLANNED
  DONE
  SKIPPED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum CoachingReportKind {
  WEEKLY
  MONTHLY
}

/**
 * One per student. Holds only what planning needs — no birth date, school name or other
 * personal data. `isMinor` + `guardianConsentAt` gate activation for under-18 learners.
 */
model CoachingProfile {
  id                String          @id @default(cuid())
  userId            String          @unique
  enabled           Boolean         @default(true)
  pathway           CoachingPathway
  examVersion       String
  /**
   * Site ExamType slug whose lessons/questions the plan links to (null = no site content, e.g. none yet).
   */
  contentExamSlug   String?
  targetScore       String?
  /**
   * { reading: "7", writing: "6.5", ... } on the exam's own scale.
   */
  skillTargets      Json?
  /**
   * Exam date as entered by the student (always labelled as such).
   */
  examDate          DateTime?       @db.Date
  currentLevel      String?
  recentScore       String?
  /**
   * "PRACTICE" | "OFFICIAL" — a student-reported score, never shown as verified.
   */
  recentScoreKind   String?
  /**
   * ISO weekdays 1 (Mon) – 7 (Sun).
   */
  studyDays         Int[]
  dailyMinutes      Int
  commitment        String?
  difficulties      String[]        @default([])
  reminderTime      String          @default("19:00")
  timezone          String          @default("Europe/Istanbul")
  locale            String          @default("tr")
  notifyInApp       Boolean         @default(true)
  notifyEmail       Boolean         @default(false)
  /**
   * "NORMAL" | "LOW" (only essential follow-ups)
   */
  frequency         String          @default("NORMAL")
  quietStart        String          @default("22:00")
  quietEnd          String          @default("08:00")
  pausedUntil       DateTime?
  isMinor           Boolean         @default(false)
  guardianConsentAt DateTime?
  vocabSourceCursor Int             @default(0)
  lastSyncedAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coaching_profiles")
}

model StudyPlanWeek {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime @db.Date
  /**
   * Snapshot of the inputs the week was generated with (minutes, days, weak skills).
   */
  basis     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks StudyTask[]

  @@unique([userId, weekStart])
  @@map("study_plan_weeks")
}

model StudyTask {
  id              String          @id @default(cuid())
  weekId          String
  userId          String
  date            DateTime        @db.Date
  position        Int             @default(0)
  kind            StudyTaskKind
  skill           String?
  title           String
  detail          String?
  href            String?
  /**
   * What the task points at ("EXAM_TOPIC", "DIAGNOSTIC_TOPIC", "MOCK_SET", "SPEAKING"...), for auto-completion.
   */
  refType         String?
  refId           String?
  /**
   * No matching cannice-english content exists — an editable self-study task instead.
   */
  isGap           Boolean         @default(false)
  minutes         Int
  /**
   * Shorter "busy day" version; null = skipped on a busy day.
   */
  busyMinutes     Int?
  status          StudyTaskStatus @default(PLANNED)
  /**
   * "BUSY" | "STUDENT" | "MISSED"
   */
  skipReason      String?
  /**
   * "AUTO" (detected from real activity) | "SELF" (student ticked it)
   */
  completion      String?
  completedAt     DateTime?
  selfMinutes     Int?
  attemptId       String?
  startedAt       DateTime?
  postponedCount  Int             @default(0)
  editedByStudent Boolean         @default(false)
  createdAt       DateTime        @default(now())

  week StudyPlanWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("study_tasks")
}

/**
 * A substantial plan change the coach suggests — applied only after the student confirms.
 */
model PlanProposal {
  id        String         @id @default(cuid())
  userId    String
  reason    String
  summary   String
  payload   Json
  status    ProposalStatus @default(PENDING)
  createdAt DateTime       @default(now())
  decidedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("plan_proposals")
}

/**
 * Leitner-box spaced vocabulary review. Mastery needs several successful reviews on different days.
 */
model VocabCard {
  id             String    @id @default(cuid())
  userId         String
  term           String
  meaning        String
  example        String?
  /**
   * "SITE" (from a Konu Anlatımı glossary lesson) | "STUDENT"
   */
  source         String
  sourceRef      String?
  box            Int       @default(1)
  dueAt          DateTime
  reviews        Int       @default(0)
  lapses         Int       @default(0)
  lastReviewedAt DateTime?
  masteredAt     DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, term])
  @@index([userId, dueAt])
  @@map("vocab_cards")
}

/**
 * Kişisel hata defteri — collected automatically from wrong answers, or added by the student.
 */
model MistakeEntry {
  id            String    @id @default(cuid())
  userId        String
  questionId    String?
  note          String?
  topicTags     String[]  @default([])
  /**
   * "AUTO" | "MANUAL"
   */
  source        String
  timesWrong    Int       @default(1)
  correctStreak Int       @default(0)
  lastWrongAt   DateTime  @default(now())
  lastRetryDay  String?
  dueAt         DateTime
  masteredAt    DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, dueAt])
  @@map("mistake_entries")
}

model CoachingCheckIn {
  id             String   @id @default(cuid())
  userId         String
  weekStart      DateTime @db.Date
  /**
   * "EASY" | "OK" | "HARD"
   */
  manageable     String
  hardestSkills  String[] @default([])
  blockers       String[] @default([])
  /**
   * "LESS" | "SAME" | "MORE"
   */
  workloadChange String
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("coaching_check_ins")
}

model CoachingFeedback {
  id                String   @id @default(cuid())
  userId            String
  /**
   * "ADVICE" (report unhelpful advice) | "REPORT" (report survey)
   */
  kind              String
  refId             String?
  useful            Boolean?
  workloadRealistic Boolean?
  /**
   * "TOO_MANY" | "OK" | "TOO_FEW"
   */
  reminderFrequency String?
  message           String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("coaching_feedback")
}

model CoachingReport {
  id          String             @id @default(cuid())
  userId      String
  kind        CoachingReportKind
  periodStart DateTime           @db.Date
  periodEnd   DateTime           @db.Date
  data        Json
  createdAt   DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodStart])
  @@map("coaching_reports")
}

/**
 * Delivery log for coaching follow-ups. The unique dedupeKey makes every reminder send at most
 * once; `notificationId` links to the in-app notification so engagement (read or not) can throttle
 * future reminders.
 */
model CoachingNotificationLog {
  id             String   @id @default(cuid())
  userId         String
  kind           String
  dedupeKey      String
  channel        String
  /**
   * "SENT" | "SKIPPED_PREFS" | "SKIPPED_THROTTLE"
   */
  status         String
  notificationId String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("coaching_notification_logs")
}

// ---------------------------------------------------------------------------------------------
// Kelime Motoru (vocabulary engine). Words live in content/vocabulary/*.ts (static, versioned
// with the code); the database only stores each student's own progress, notes and set tests.
// ---------------------------------------------------------------------------------------------

/**
 * A student's state for one word: whether they marked it known or still learning, and their
 * own note. `wordId` is the stable id from the content files (e.g. "a1-apple").
 */
model LexiconWordState {
  id        String    @id @default(cuid())
  userId    String
  wordId    String
  level     String
  /**
   * "KNOWN" | "LEARNING" (null = seen only / note only)
   */
  status    String?
  note      String?
  seenAt    DateTime?
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, level])
  @@map("lexicon_word_states")
}

/** One finished test after a flashcard set. */
model LexiconSetTest {
  id           String   @id @default(cuid())
  userId       String
  level        String
  setNumber    Int
  score        Int
  total        Int
  wrongWordIds String[] @default([])
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, level, setNumber])
  @@map("lexicon_set_tests")
}
