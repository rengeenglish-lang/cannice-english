/**
 * One row per student per (Europe/Istanbul) calendar day they used the site — powers İlerleme Raporu's visit frequency.
 */
model UserVisit {
  id        String   @id @default(cuid())
  userId    String
  day       DateTime @db.Date
  pageViews Int      @default(1)
  lastSeen  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("user_visits")
