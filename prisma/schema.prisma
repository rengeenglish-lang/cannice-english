/**
 * Favorilerim — products a student saved for later (heart button, or "Favorilere taşı" from the cart).
 */
model FavoriteProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorite_products")
}

enum StudyGoalPeriod {
  DAY
  WEEK
  MONTH
}

enum StudyGoalStatus {
  ACTIVE
  REACHED
  FAILED
}

enum StudyGoalItemKind {
  TOPIC
  PRACTICE
  MOCK_EXAM
  CUSTOM
}

/// A student-set study goal for a day/week/month, e.g. "3 topics + 1 deneme this week".
/// Not tied to a specific exam (a student may be preparing for more than one) - the topic
/// picker in the UI just defaults to their active ExamGoal's exam for convenience.
model StudyGoal {
  id            String          @id @default(cuid())
  userId        String
  period        StudyGoalPeriod
  periodStart   DateTime
  periodEnd     DateTime
  status        StudyGoalStatus @default(ACTIVE)
  reachedAt     DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items StudyGoalItem[]

  @@index([userId, period, periodStart])
  @@index([userId, status])
  @@map("study_goals")
}

/// One line item within a StudyGoal: a specific topic, N practice sets, N deneme (mock exams),
/// or a freeform line the student typed themselves.
model StudyGoalItem {
  id          String            @id @default(cuid())
  studyGoalId String
  kind        StudyGoalItemKind
  examTopicId String?
  quantity    Int?
  label       String?
  createdAt   DateTime          @default(now())

  studyGoal StudyGoal  @relation(fields: [studyGoalId], references: [id], onDelete: Cascade)
  examTopic ExamTopic? @relation(fields: [examTopicId], references: [id], onDelete: SetNull)

  @@index([studyGoalId])
  @@map("study_goal_items")
}

// ====================================================================
// ÜCRETSİZ ÖĞRENCİ KOÇLUĞU (free, automated English exam coaching)
// ====================================================================

/**
 * Coaching pathways. Versions (IELTS Academic/General, e-YDS, YÖKDİL branch...) live in lib/coaching/exams.ts.
 */
enum CoachingPathway {
  IELTS
  TOEFL
  PTE
  YDS
  YOKDIL
  YDT
}

enum StudyTaskKind {
  LESSON
  PRACTICE
  TIMED_PRACTICE
  MOCK
  LEVEL_TEST
  VOCAB_REVIEW
  MISTAKE_REVIEW
  SPEAKING
  WRITING
  LISTENING
  READING
  CUSTOM
}

enum StudyTaskStatus {
  PLANNED
  DONE
  SKIPPED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum CoachingReportKind {
  WEEKLY
  MONTHLY
}

/**
 * One per student. Holds only what planning needs — no birth date, school name or other
 * personal data. `isMinor` + `guardianConsentAt` gate activation for under-18 learners.
 */
model CoachingProfile {
  id                String          @id @default(cuid())
  userId            String          @unique
  enabled           Boolean         @default(true)
  pathway           CoachingPathway
  examVersion       String
  /**
   * Site ExamType slug whose lessons/questions the plan links to (null = no site content, e.g. none yet).
   */
  contentExamSlug   String?
  targetScore       String?
  /**
   * { reading: "7", writing: "6.5", ... } on the exam's own scale.
   */
  skillTargets      Json?
  /**
   * Exam date as entered by the student (always labelled as such).
   */
  examDate          DateTime?       @db.Date
  currentLevel      String?
  recentScore       String?
  /**
   * "PRACTICE" | "OFFICIAL" — a student-reported score, never shown as verified.
   */
  recentScoreKind   String?
  /**
   * ISO weekdays 1 (Mon) – 7 (Sun).
   */
  studyDays         Int[]
  dailyMinutes      Int
  commitment        String?
  difficulties      String[]        @default([])
  reminderTime      String          @default("19:00")
  timezone          String          @default("Europe/Istanbul")
  locale            String          @default("tr")
  notifyInApp       Boolean         @default(true)
  notifyEmail       Boolean         @default(false)
  /**
   * "NORMAL" | "LOW" (only essential follow-ups)
   */
  frequency         String          @default("NORMAL")
  quietStart        String          @default("22:00")
  quietEnd          String          @default("08:00")
  pausedUntil       DateTime?
  isMinor           Boolean         @default(false)
  guardianConsentAt DateTime?
  vocabSourceCursor Int             @default(0)
  lastSyncedAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coaching_profiles")
}

model StudyPlanWeek {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime @db.Date
  /**
   * Snapshot of the inputs the week was generated with (minutes, days, weak skills).
   */
  basis     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks StudyTask[]

  @@unique([userId, weekStart])
  @@map("study_plan_weeks")
}

model StudyTask {
  id              String          @id @default(cuid())
  weekId          String
  userId          String
  date            DateTime        @db.Date
  position        Int             @default(0)
  kind            StudyTaskKind
  skill           String?
  title           String
  detail          String?
  href            String?
  /**
   * What the task points at ("EXAM_TOPIC", "DIAGNOSTIC_TOPIC", "MOCK_SET", "SPEAKING"...), for auto-completion.
   */
  refType         String?
  refId           String?
  /**
   * No matching cannice-english content exists — an editable self-study task instead.
   */
  isGap           Boolean         @default(false)
  minutes         Int
  /**
   * Shorter "busy day" version; null = skipped on a busy day.
   */
  busyMinutes     Int?
  /**
   * Volume target set by the plan (e.g. 25 words, 40 questions); null for time-only tasks.
   */
  targetCount     Int?
  /**
   * "WORDS" | "QUESTIONS" | "MOCK" | "TEXT"
   */
  unit            String?
  status          StudyTaskStatus @default(PLANNED)
  /**
   * "BUSY" | "STUDENT" | "MISSED"
   */
  skipReason      String?
  /**
   * "AUTO" (detected from real activity) | "SELF" (student ticked it)
   */
  completion      String?
  completedAt     DateTime?
  selfMinutes     Int?
  attemptId       String?
  startedAt       DateTime?
  postponedCount  Int             @default(0)
  editedByStudent Boolean         @default(false)
  createdAt       DateTime        @default(now())

  week StudyPlanWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("study_tasks")
}

/**
 * A substantial plan change the coach suggests — applied only after the student confirms.
 */
model PlanProposal {
  id        String         @id @default(cuid())
  userId    String
  reason    String
  summary   String
  payload   Json
  status    ProposalStatus @default(PENDING)
  createdAt DateTime       @default(now())
  decidedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("plan_proposals")
}

/**
 * Leitner-box spaced vocabulary review. Mastery needs several successful reviews on different days.
 */
model VocabCard {
  id             String    @id @default(cuid())
  userId         String
  term           String
  meaning        String
  example        String?
  /**
   * "SITE" (from a Konu Anlatımı glossary lesson) | "STUDENT"
   */
  source         String
  sourceRef      String?
  box            Int       @default(1)
  dueAt          DateTime
  reviews        Int       @default(0)
  lapses         Int       @default(0)
  lastReviewedAt DateTime?
  /**
   * When the student last answered "Bilemedim"; dates the card's page in the hata defteri.
   */
  lastLapseAt    DateTime?
  masteredAt     DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, term])
  @@index([userId, dueAt])
  @@map("vocab_cards")
}

/**
 * Kişisel hata defteri — collected automatically from wrong answers, or added by the student.
 */
model MistakeEntry {
  id            String    @id @default(cuid())
  userId        String
  questionId    String?
  note          String?
  topicTags     String[]  @default([])
  /**
   * "AUTO" | "MANUAL"
   */
  source        String
  timesWrong    Int       @default(1)
  correctStreak Int       @default(0)
  lastWrongAt   DateTime  @default(now())
  lastRetryDay  String?
  dueAt         DateTime
  masteredAt    DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, dueAt])
  @@map("mistake_entries")
}

model CoachingCheckIn {
  id             String   @id @default(cuid())
  userId         String
  weekStart      DateTime @db.Date
  /**
   * "EASY" | "OK" | "HARD"
   */
  manageable     String
  hardestSkills  String[] @default([])
  blockers       String[] @default([])
  /**
   * "LESS" | "SAME" | "MORE"
   */
  workloadChange String
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("coaching_check_ins")
}

model CoachingFeedback {
  id                String    @id @default(cuid())
  userId            String
  /**
   * "ADVICE" (report unhelpful advice) | "REPORT" (report survey) | "SUGGESTION" (free-form idea)
   */
  kind              String
  refId             String?
  useful            Boolean?
  workloadRealistic Boolean?
  /**
   * "TOO_MANY" | "OK" | "TOO_FEW"
   */
  reminderFrequency String?
  message           String?
  /**
   * Set when an admin marks the suggestion as handled in Yönetim → Gelen Koçluk Önerileri.
   */
  handledAt         DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("coaching_feedback")
}

model CoachingReport {
  id          String             @id @default(cuid())
  userId      String
  kind        CoachingReportKind
  periodStart DateTime           @db.Date
  periodEnd   DateTime           @db.Date
  data        Json
  createdAt   DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodStart])
  @@map("coaching_reports")
}

/**
 * Delivery log for coaching follow-ups. The unique dedupeKey makes every reminder send at most
 * once; `notificationId` links to the in-app notification so engagement (read or not) can throttle
 * future reminders.
 */
model CoachingNotificationLog {
  id             String   @id @default(cuid())
  userId         String
  kind           String
  dedupeKey      String
  channel        String
  /**
   * "SENT" | "SKIPPED_PREFS" | "SKIPPED_THROTTLE"
   */
  status         String
  notificationId String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("coaching_notification_logs")
}

// ---------------------------------------------------------------------------------------------
// Kelime Motoru (vocabulary engine). Words live in content/vocabulary/*.ts (static, versioned
// with the code); the database only stores each student's own progress, notes and set tests.
// ---------------------------------------------------------------------------------------------

/**
 * A student's state for one word: whether they marked it known or still learning, and their
 * own note. `wordId` is the stable id from the content files (e.g. "a1-apple").
 */
model LexiconWordState {
  id        String    @id @default(cuid())
  userId    String
  wordId    String
  level     String
  /**
   * "KNOWN" | "LEARNING" (null = seen only / note only)
   */
  status    String?
  note      String?
  seenAt    DateTime?
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, level])
  @@map("lexicon_word_states")
}

/**
 * One finished test after a flashcard set.
 */
model LexiconSetTest {
  id           String   @id @default(cuid())
  userId       String
  level        String
  setNumber    Int
  score        Int
  total        Int
  wrongWordIds String[] @default([])
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, level, setNumber])
  @@map("lexicon_set_tests")
}

// SEO inventory is derived from existing content, not a second publishing system.
model SeoContentItem {
  id              String    @id @default(cuid())
  sourceKey       String    @unique
  sourceType      String
  sourceId        String
  url             String
  title           String
  excerpt         String?
  seoTitle        String?
  seoDescription  String?
  examSlug        String?
  topic           String?
  languageCode    String?
  access          String
  publication     String
  contentHash     String
  internalLinks   Json
  publishedAt     DateTime?
  sourceUpdatedAt DateTime?
  scannedAt       DateTime
  available       Boolean   @default(true)

  @@index([url])
  @@index([available, sourceType])
  @@index([examSlug])
  @@index([scannedAt])
  @@map("seo_content_items")
}

model SeoActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  details   Json
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, action, createdAt])
  @@map("seo_activity_logs")
}

// Phase 2 research records. Unknown demand is NULL, never fabricated.
model SeoKeyword {
  articleDraft    SeoArticleDraft?
  serpResults     SeoSerpResult[]
  id              String           @id @default(cuid())
  keyword         String
  normalized      String
  languageCode    String
  market          String
  intent          String
  examId          String?
  sourceNote      String
  monthlySearches Int?
  demandSource    String?
  demandCheckedAt DateTime?
  archived        Boolean          @default(false)
  revision        Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  exam ExamType? @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@unique([normalized, languageCode, market])
  @@index([examId])
  @@index([archived, updatedAt])
  @@map("seo_keywords")
}

// Workflow metadata only: article text remains in the existing BlogPost.
model SeoArticleDraft {
  approvedLinks Json                @default("[]")
  id            String              @id @default(cuid())
  keywordId     String              @unique
  postId        String              @unique
  brief         Json
  briefReady    Boolean             @default(false)
  revision      Int                 @default(0)
  reviewedHash  String?
  reviewedAt    DateTime?
  approvedHash  String?
  approvedAt    DateTime?
  approvedById  String?
  scheduledFor  DateTime?
  scheduleError String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  keyword       SeoKeyword          @relation(fields: [keywordId], references: [id], onDelete: Restrict)
  post          BlogPost            @relation(fields: [postId], references: [id], onDelete: Cascade)
  versions      SeoArticleVersion[]

  @@index([updatedAt])
  @@index([scheduledFor])
  @@map("seo_article_drafts")
}

model SeoArticleVersion {
  id        String          @id @default(cuid())
  draftId   String
  version   Int
  reason    String
  snapshot  Json
  score     Int?
  actorId   String?
  createdAt DateTime        @default(now())
  draft     SeoArticleDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, version])
  @@map("seo_article_versions")
}

model SeoSlugRedirect {
  id        String   @id @default(cuid())
  fromSlug  String   @unique
  postId    String
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("seo_slug_redirects")
}

// Phase 5: immutable-per-period Search Console performance snapshots (API sync or manual CSV import).
model SeoSearchSnapshot {
  id           String         @id @default(cuid())
  periodStart  DateTime       @db.Date
  periodEnd    DateTime       @db.Date
  kind         String
  source       String
  rowCount     Int
  droppedRows  Int            @default(0)
  importedById String?
  createdAt    DateTime       @default(now())
  rows         SeoSearchRow[]

  @@unique([kind, periodStart, periodEnd])
  @@index([kind, periodEnd])
  @@map("seo_search_snapshots")
}

model SeoSearchRow {
  id          String            @id @default(cuid())
  snapshotId  String
  page        String            @default("")
  query       String            @default("")
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  snapshot    SeoSearchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, page, query])
  @@index([snapshotId, page])
  @@map("seo_search_rows")
}

// Phase 6: cookie-free, aggregate article traffic. No visitor identifier is stored.
model SeoArticleDay {
  id           String   @id @default(cuid())
  postId       String
  day          DateTime @db.Date
  organicViews Int      @default(0)
  otherViews   Int      @default(0)
  post         BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, day])
  @@map("seo_article_days")
}

// First-touch link between a new account and the article whose register link it used.
model SeoAttribution {
  id        String    @id @default(cuid())
  userId    String    @unique
  postId    String?
  slug      String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      BlogPost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@map("seo_attributions")
}

// Phase 7: durable background jobs (claimed with SKIP LOCKED, retried with backoff) and AI spend ledger.
model SeoJob {
  id          String    @id @default(cuid())
  type        String
  status      String    @default("QUEUED")
  dedupeKey   String    @unique
  payload     Json
  runAt       DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lockedAt    DateTime?
  finishedAt  DateTime?
  lastError   String?
  result      Json?
  createdAt   DateTime  @default(now())

  @@index([status, runAt])
  @@map("seo_jobs")
}

model SeoAiUsage {
  id           String    @id @default(cuid())
  month        String
  provider     String
  model        String
  operation    String
  status       String    @default("RESERVED")
  estimatedUsd Decimal   @db.Decimal(10, 4)
  actualUsd    Decimal?  @db.Decimal(10, 4)
  inputTokens  Int?
  outputTokens Int?
  draftId      String?
  actorId      String?
  createdAt    DateTime  @default(now())
  settledAt    DateTime?

  @@index([month, status])
  @@index([createdAt])
  @@map("seo_ai_usage")
}

// Phase 8: competitor strategy data. Only titles/URLs/domains an admin entered or imported; no scraped article text.
model SeoCompetitor {
  id          String               @id @default(cuid())
  name        String
  domain      String               @unique
  notes       String               @default("")
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  topics      SeoCompetitorTopic[]
  serpResults SeoSerpResult[]

  @@map("seo_competitors")
}

model SeoCompetitorTopic {
  id           String        @id @default(cuid())
  competitorId String
  title        String
  normalized   String
  url          String?
  createdAt    DateTime      @default(now())
  competitor   SeoCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, normalized])
  @@map("seo_competitor_topics")
}

model SeoSerpResult {
  id           String         @id @default(cuid())
  keywordId    String
  rank         Int
  domain       String
  title        String
  url          String
  competitorId String?
  createdAt    DateTime       @default(now())
  keyword      SeoKeyword     @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  competitor   SeoCompetitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  @@unique([keywordId, rank])
  @@index([domain])
  @@map("seo_serp_results")
}

/**
 * Yazma ve Çeviri Geri Bildirimi: one AI-graded writing or translation answer. `kind` is a
 * WRITING_FEEDBACK_KINDS key (lib/writing-feedback.ts); `result` holds the validated feedback JSON.
 * PENDING rows reserve their estimated cost against the monthly AI cap until the call finishes;
 * FAILED rows count against neither the cap nor the student's monthly allowance.
 */
model WritingFeedback {
  id           String    @id @default(cuid())
  userId       String
  kind         String
  taskPrompt   String
  answer       String
  status       String    @default("PENDING")
  result       Json?
  errorMessage String?
  model        String
  estimatedUsd Decimal   @db.Decimal(10, 5)
  actualUsd    Decimal?  @db.Decimal(10, 5)
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt, status])
  @@map("writing_feedback")
}

/**
 * Hatalarım "Neden yanlış yaptım?": an AI explanation of one wrong option of one question, shared by
 * every student who picks that option, so it is generated (and paid for) once. `answer` is the
 * chosen option index as stored in DiagnosticResponse.answerRaw. `result` holds the validated
 * explanation JSON (lib/mistake-explain.ts). PENDING rows reserve their estimated cost against the
 * monthly cap until the call finishes.
 */
model MistakeExplanation {
  id           String    @id @default(cuid())
  questionId   String
  answer       String
  status       String    @default("PENDING")
  result       Json?
  errorMessage String?
  model        String
  estimatedUsd Decimal   @db.Decimal(10, 5)
  actualUsd    Decimal?  @db.Decimal(10, 5)
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?

  question DiagnosticQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  views    MistakeExplanationView[]

  @@unique([questionId, answer])
  @@index([createdAt, status])
  @@map("mistake_explanations")
}

/**
 * One student opening an explanation. `charged` = this request generated it (counts against the daily allowance).
 */
model MistakeExplanationView {
  id            String   @id @default(cuid())
  userId        String
  explanationId String
  charged       Boolean  @default(false)
  createdAt     DateTime @default(now())

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  explanation MistakeExplanation @relation(fields: [explanationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([explanationId])
  @@map("mistake_explanation_views")
}

// ====================================================================
// ACCOUNT EMAILS
// ====================================================================

enum AuthTokenKind {
  BOOK_SIGNIN
  PASSWORD_RESET
  EMAIL_VERIFY
}

/// Single-use links sent by email. Only the SHA-256 of the token is stored.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("auth_tokens")
}

/// One row per transactional email sent, keyed so the same email is never sent twice
/// (e.g. "order-paid:<orderId>", "session-day:<sessionId>:<userId>").
model EmailLog {
  id        String   @id @default(cuid())
  key       String   @unique
  kind      String
  to        String
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@map("email_logs")
}

// ====================================================================
// INVOICES (in-house; archived to Google Drive)
// ====================================================================

enum InvoiceStatus {
  ISSUED
  VOID
}

/// One invoice per paid order. Everything printed on it is snapshotted here, so the PDF can be
/// rebuilt identically at any time; the Drive copy is the archive.
model Invoice {
  id            String        @id @default(cuid())
  /// "NF-2026-000001": sequential per calendar year, never reused.
  number        String        @unique
  orderId       String        @unique
  userId        String?
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  voidedAt      DateTime?
  currency      String        @default("TRY")
  subtotal      Decimal       @db.Decimal(12, 2)
  discountTotal Decimal       @default(0) @db.Decimal(12, 2)
  shippingTotal Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  /// Tax included in the total (0 when the invoice shows no tax line).
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod String
  seller        Json
  buyer         Json
  items         Json
  /// Control/invoice number from KRA eTIMS, entered by staff when the invoice is also filed there.
  etimsNumber   String?
  driveFileId   String?
  driveSyncedAt DateTime?
  /// True when the Drive copy is missing or out of date (e.g. after voiding); the hourly job retries.
  driveDirty    Boolean       @default(true)
  driveError    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, issuedAt])
  @@index([driveDirty])
  @@map("invoices")
}

model InvoiceSequence {
  year Int @id
  last Int @default(0)

  @@map("invoice_sequences")
}

/// Google Drive folders the site created: "root" and one per customer ("customer:<email>").
model DriveFolder {
  key       String   @id
  folderId  String
  createdAt DateTime @default(now())

  @@map("drive_folders")
}

/// Proof of consent: every acceptance, grant and withdrawal, with the wording version shown.
model ConsentLog {
  id          String   @id @default(cuid())
  userId      String
  /// "TERMS" | "MARKETING_EMAIL" | "MARKETING_SMS" | "MARKETING_PHONE"
  kind        String
  granted     Boolean
  textVersion String
  /// "REGISTER" | "GOOGLE" | "PROFILE"
  source      String
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("consent_logs")
}

// ====================================================================
// ENGAGEMENT: certificates, badges, push, referrals
// ====================================================================

/// A completion certificate. `code` is the public verification id (netfener.com/sertifika/<code>).
model Certificate {
  id            String   @id @default(cuid())
  code          String   @unique
  userId        String
  /// "TOPICS" (an exam's whole Konu Anlatımı track) | "COURSE"
  kind          String
  /// Exam type slug for TOPICS, course id for COURSE.
  refKey        String
  title         String
  recipientName String
  lessonCount   Int
  issuedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refKey])
  @@map("certificates")
}

/// A badge earned once (see lib/engagement.ts for the list).
model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeKey String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@map("user_badges")
}

/// A browser/phone that accepted push notifications (Web Push).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// The exams a learner is preparing for (at most two, enforced in exam-interests.service). They
/// pick the countdowns shown across the site and limit exam-specific study material to these exams.
model UserExamInterest {
  id        String    @id @default(cuid())
  userId    String
  examCode  ExamCode
  /// The learner's own exam date, e.g. a booked IELTS session; ÖSYM exams fall back to the calendar.
  examDate  DateTime? @db.Date
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, examCode])
  @@map("user_exam_interests")
}

enum SiteReviewKind {
  TEXT
  VIDEO
}

enum SiteReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A learner's review of Netfener itself (not a product). Held for moderation before it goes public;
/// a reward coupon (when the promotion is on) is issued at submission and withdrawn on rejection.
model SiteReview {
  id               String           @id @default(cuid())
  userId           String
  kind             SiteReviewKind
  status           SiteReviewStatus @default(PENDING)
  rating           Int
  displayName      String
  examCode         ExamCode?
  body             String
  /// Uploaded video in the R2 reviews bucket, or a YouTube/Instagram/TikTok/Drive link.
  videoKey         String?
  videoUrl         String?
  /// Length of an uploaded video in seconds (max 90), as read from the file.
  videoSeconds     Int?
  /// Exact wording the learner agreed to for showing their video on the site, and when.
  usageConsentText String?
  usageConsentAt   DateTime?
  rewardCouponId   String?          @unique
  featured         Boolean          @default(false)
  rejectReason     String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user       User  @relation("SiteReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("SiteReviewModerator", fields: [reviewedById], references: [id], onDelete: SetNull)
  ebookPromotionAccess EbookPromotionAccess?

  @@index([status, featured, createdAt])
  @@index([userId])
  @@map("site_reviews")
}

/// One first-book choice and one review reward per account. Paid purchases remain separate.
model EbookPromotionAccess {
  userId              String   @id
  firstBookSlug       String?
  firstDownloadedAt   DateTime?
  unlockedAt          DateTime?
  reviewId            String?  @unique
  trialSubscriptionId String?  @unique

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  review            SiteReview?       @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  trialSubscription PlanSubscription? @relation(fields: [trialSubscriptionId], references: [id], onDelete: SetNull)

  @@map("ebook_promotion_access")
}

model UserEbookSelection {
  userId    String
  bookSlug  String
  selectedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, bookSlug])
  @@map("user_ebook_selections")
}

/// Result of the general English placement test (Speaking Club grouping). The latest one counts.
model EnglishPlacement {
  id        String   @id @default(cuid())
  userId    String
  /// CEFR band A1–C2 from the test.
  cefr      String
  correct   Int
  total     Int
  /// { questionId: chosenIndex } — kept so a result can be explained or re-scored.
  answers   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("english_placements")
}

// Commercial foundation. Amounts are integer kuruş; payment periods never define curriculum length.
enum BillingInterval {
  MONTHLY
  QUARTERLY
  SIX_MONTH
  ANNUAL
}

enum CommercialKind {
  PREMIUM
  GROUP
}

enum ToolAccessPolicy {
  FREE
  PREMIUM
  GROUP_INCLUDED
  SEPARATE_PURCHASE
}

enum Capability {
  FREE_CONTENT
  PREMIUM_SIMULATIONS
  QUESTION_BANK
  PERFORMANCE_ANALYTICS
  STUDY_TOOLS
  DIGITAL_RESOURCES
  HOMEWORK
  TEACHER_FEEDBACK
  GROUP_LESSONS
  GROUP_FULL_ACCESS
}

model CommercialPrice {
  id              String          @id @default(cuid())
  kind            CommercialKind
  interval        BillingInterval
  amountMinor     Int
  currency        String          @default("TRY")
  active          Boolean         @default(true)
  checkoutEnabled Boolean         @default(false)
  updatedAt       DateTime        @updatedAt

  @@unique([kind, interval])
  @@map("commercial_prices")
}

model LearningTool {
  key     String           @id
  name    String
  policy  ToolAccessPolicy @default(SEPARATE_PURCHASE)
  enabled Boolean          @default(false)

  @@map("learning_tools")
}

model MembershipSubscription {
  id          String          @id @default(cuid())
  userId      String
  orderItemId String          @unique
  interval    BillingInterval
  startsAt    DateTime
  expiresAt   DateTime
  revokedAt   DateTime?
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("membership_subscriptions")
}

model AccessGrant {
  id          String     @id @default(cuid())
  userId      String
  orderItemId String
  capability  Capability
  startsAt    DateTime
  expiresAt   DateTime
  revokedAt   DateTime?
  user        User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, capability])
  @@index([userId, expiresAt])
  @@map("access_grants")
}

model CommercialAudit {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String
  details   Json
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetId, createdAt])
  @@map("commercial_audit")
}

// Structured programmes extend existing courses and lessons; billing is independent.
enum CurriculumActivityType {
  LIVE_INSTRUCTION
  GUIDED_PRACTICE
  EXAM_SIMULATION
  INDEPENDENT_STUDY
  REVIEW_ASSESSMENT
}

model ModuleDurationBudget {
  id       String                 @id @default(cuid())
  moduleId String
  type     CurriculumActivityType
  minutes  Int
  module   CourseModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, type])
  @@map("module_duration_budgets")
}

model CurriculumUnit {
  id        String           @id @default(cuid())
  moduleId  String
  title     String
  objective String
  position  Int
  module    CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons   RecordedLesson[]

  @@unique([moduleId, position])
  @@map("curriculum_units")
}

model CurriculumActivity {
  id                 String                 @id @default(cuid())
  lessonId           String
  title              String
  position           Int
  type               CurriculumActivityType
  durationMinutes    Int
  instructions       String
  completionCriteria String
  topicLessonId      String?
  freeResourceId     String?
  // Identifies a verified server-side simulation adapter; empty until one exists.
  simulationKey      String?
  lesson             RecordedLesson         @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  topicLesson        TopicLesson?           @relation(fields: [topicLessonId], references: [id], onDelete: Restrict)
  freeResource       FreeResource?          @relation(fields: [freeResourceId], references: [id], onDelete: Restrict)
  assessment         ActivityAssessment?
  prerequisites      ActivityPrerequisite[] @relation("ActivityPrerequisites")
  dependents         ActivityPrerequisite[] @relation("ActivityDependents")
  completions        ActivityCompletion[]

  @@unique([lessonId, position])
  @@index([topicLessonId])
  @@index([freeResourceId])
  @@map("curriculum_activities")
}

model ActivityAssessment {
  id           String             @id @default(cuid())
  activityId   String             @unique
  rubric       String
  minimumScore Int?
  activity     CurriculumActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_assessments")
}

model ActivityPrerequisite {
  activityId     String
  prerequisiteId String
  activity       CurriculumActivity @relation("ActivityPrerequisites", fields: [activityId], references: [id], onDelete: Cascade)
  prerequisite   CurriculumActivity @relation("ActivityDependents", fields: [prerequisiteId], references: [id], onDelete: Restrict)

  @@id([activityId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("activity_prerequisites")
}

model ActivityCompletion {
  id              String              @id @default(cuid())
  enrollmentId    String
  activityId      String
  verifiedById    String
  completedAt     DateTime            @default(now())
  // Immutable credit snapshot, never client-supplied or derived from calendar time.
  creditedMinutes Int
  evidenceNote    String
  submissionId    String?             @unique
  liveSessionId   String?
  revokedAt       DateTime?
  enrollment      Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  activity        CurriculumActivity  @relation(fields: [activityId], references: [id], onDelete: Restrict)
  verifiedBy      User                @relation("ActivityVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  submission      PracticeSubmission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  liveSession     LiveSession?        @relation(fields: [liveSessionId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, activityId])
  @@unique([enrollmentId, liveSessionId])
  @@index([activityId])
  @@index([verifiedById])
  @@map("activity_completions")
}

enum CohortStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
  ARCHIVED
}

enum CohortEnrollmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CohortWaitlistStatus {
  WAITING
  ENROLLED
  CANCELLED
}

model ProgrammeCohort {
  id              String             @id @default(cuid())
  courseId        String
  teacherId       String
  title           String
  startsAt        DateTime
  expectedEndsAt  DateTime
  timezone        String             @default("Europe/Istanbul")
  minimumCapacity Int                @default(5)
  maximumCapacity Int                @default(10)
  graceDays       Int                @default(0)
  seatHoldMinutes Int                @default(1440)
  salesEnabled    Boolean            @default(false)
  orderItems      OrderItem[]
  reservations    SeatReservation[]
  status          CohortStatus       @default(DRAFT)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  course          Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacher         User               @relation("CohortTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  schedule        CohortSchedule[]
  enrollments     CohortEnrollment[]
  waitlist        CohortWaitlist[]
  sessions        LiveSession[]
  events          CohortEvent[]

  @@index([courseId, status, startsAt])
  @@index([teacherId, status])
  @@map("programme_cohorts")
}

model CohortSchedule {
  id          String          @id @default(cuid())
  cohortId    String
  weekday     Int
  startMinute Int
  endMinute   Int
  cohort      ProgrammeCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, weekday, startMinute])
  @@map("cohort_schedules")
}

model CohortEnrollment {
  id          String                 @id @default(cuid())
  cohortId    String
  studentId   String
  orderItemId String?                @unique
  status      CohortEnrollmentStatus @default(PENDING)
  requestedAt DateTime               @default(now())
  confirmedAt DateTime?
  cancelledAt DateTime?
  cohort      ProgrammeCohort        @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  student     User                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  orderItem   OrderItem?             @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([cohortId, studentId])
  @@index([cohortId, status])
  @@index([studentId, status])
  @@map("cohort_enrollments")
}

model CohortWaitlist {
  id        String               @id @default(cuid())
  cohortId  String
  studentId String
  status    CohortWaitlistStatus @default(WAITING)
  joinedAt  DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  cohort    ProgrammeCohort      @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  student   User                 @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([cohortId, studentId])
  @@index([cohortId, status, joinedAt])
  @@map("cohort_waitlists")
}

// Durable event handoff for the notification phase; no message is sent or student charged here.
model CohortEvent {
  id          String          @id @default(cuid())
  cohortId    String
  type        String
  createdAt   DateTime        @default(now())
  processedAt DateTime?
  cohort      ProgrammeCohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)

  @@index([processedAt, createdAt])
  @@map("cohort_events")
}

enum PurchaseType {
  LEGACY
  PREMIUM_SUBSCRIPTION
  GROUP_PROGRAM
  DIGITAL_PRODUCT
}

model SeatReservation {
  id         String          @id @default(cuid())
  orderId    String          @unique
  cohortId   String
  expiresAt  DateTime
  releasedAt DateTime?
  createdAt  DateTime        @default(now())
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cohort     ProgrammeCohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)

  @@index([cohortId, releasedAt, expiresAt])
  @@map("seat_reservations")
}

/**
 * One sitting of an online YDS deneme (content/yds-denemeler, Deneme 1–100). The 180-minute clock
 * lives here: deadlineAt is fixed at start, answers saved after it are refused, and an attempt
 * found past its deadline is finalized (locked) on the next server touch.
 */
model OnlineDenemeAttempt {
  id          String                  @id @default(cuid())
  userId      String
  denemeNo    Int
  mode        OnlineDenemeMode        @default(KLASIK)
  status      DiagnosticAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime                @default(now())
  deadlineAt  DateTime
  completedAt DateTime?
  /**
   * True when the time ran out (locked by the clock) rather than the student finishing.
   */
  timedOut    Boolean                 @default(false)
  correct     Int?
  wrong       Int?
  blank       Int?
  /**
   * YDS score out of 100: correct × 1.25.
   */
  score       Decimal?                @db.Decimal(5, 2)
  createdAt   DateTime                @default(now())

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers OnlineDenemeAnswer[]

  @@index([userId, denemeNo, status])
  @@map("online_deneme_attempts")
}

model OnlineDenemeAnswer {
  attemptId String
  /**
   * Question number 1–80.
   */
  n         Int
  /**
   * 0–4 = A–E.
   */
  choice    Int?
  flagged   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  attempt OnlineDenemeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@id([attemptId, n])
  @@map("online_deneme_answers")
}

/// Spin-the-wheel popup: one entry per email, with the prize drawn and when consent was given.
model WheelEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  prize     String
  consentAt DateTime
  createdAt DateTime @default(now())

  @@map("wheel_entries")
}
