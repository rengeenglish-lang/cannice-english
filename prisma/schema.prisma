generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ====================================================================
// ENUMS
// ====================================================================

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN
}

enum ExamCode {
  IELTS
  TOEFL
  PTE
  YDS
  YOKDIL_SOSYAL
  YOKDIL_SAGLIK
  YOKDIL_FEN
}

enum ProductCategory {
  PREP_GROUP
  MOCK_CAMP
  STUDY_PACKAGE
  TRANSLATION_SUPPORT
  BOOK
  PLAN
}

/**
 * Deneme Sınavı subscription tiers (Başlangıç / Çırak / Uzman). Which features each tier unlocks
 * lives in lib/plans.ts — the single place site-wide access checks read from.
 */
enum PlanTier {
  BASLANGIC
  CIRAK
  UZMAN
}

/**
 * The three free live-lesson perks bundled into the Uzman plan, each claimable once per subscription.
 */
enum PlanPerk {
  SPEAKING_CLUB
  SYSTEMATIC_LIVE
  ELECTIVE_LIVE
}

/**
 * Which Kaynaklar hub section a FreeResource is listed under.
 */
enum ResourceKind {
  E_BOOK
  TOPIC
  PDF_MOCK
}

enum ProductLevel {
  BEGINNER_TO_ADVANCED
  INTERMEDIATE_ADVANCED
  JUNIOR
  SENIOR
}

enum CourseDeliveryFormat {
  HYBRID
  RECORDED_ONLY
  LIVE_ONLY
}

enum BookFormat {
  PDF
  PRINT
  PRINT_AND_PDF
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum OrderStatus {
  PAYMENT_REVIEW
  PENDING
  AWAITING_PAYMENT
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum CallbackRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

// ====================================================================
// DIAGNOSTIC / PERSONALIZED PREP JOURNEY ENUMS
// ====================================================================

enum ExamFamily {
  ACADEMIC_SKILLS
  TRANSLATION_GRAMMAR
}

enum GoalTimeframe {
  EXACT_DATE
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  UNKNOWN
}

enum DiagnosticTopicKind {
  SKILL
  SUBSKILL
  TOPIC
}

enum DiagnosticQuestionType {
  MCQ
  LISTENING_MCQ
  CLOZE
  TRANSLATION_EN_TR
  TRANSLATION_TR_EN
  SENTENCE_COMPLETION
  PARAGRAPH_COMPLETION
  READING_COMPREHENSION
  RESTATEMENT
  WRITING_TASK
  SPEAKING_TASK
}

enum DiagnosticDifficulty {
  KOLAY
  ORTA
  ZOR
}

enum DiagnosticAttemptKind {
  FULL_DIAGNOSTIC
  MASTERY_CHECK
  PRACTICE
  MOCK_EXAM
}

enum DiagnosticAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum OnlineDenemeMode {
  KLASIK
  OPTIK
}

enum DiagnosticSeverity {
  CRITICAL
  NEEDS_IMPROVEMENT
  DEVELOPING
  STRONG
}

enum RoadmapItemStatus {
  NOT_STARTED
  IN_PROGRESS
  MASTERY_CHECK_REQUIRED
  COMPLETED
}

// ====================================================================
// REFERENCE DATA
// ====================================================================

model ExamType {
  seoKeywords      SeoKeyword[]
  id               String       @id @default(cuid())
  code             ExamCode     @unique
  slug             String       @unique
  name             String
  shortDescription String?
  iconKey          String?
  displayOrder     Int          @default(0)
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  products            Product[]
  testimonials        Testimonial[]
  dictionaryTerms     DictionaryTerm[]
  scoreConversionRows ScoreConversionEntry[]
  calendarEntries     ExamCalendarEntry[]
  freeResources       FreeResource[]
  callbackRequests    CallbackRequest[]
  topics              ExamTopic[]
  examGoals           ExamGoal[]
  diagnosticAttempts  DiagnosticAttempt[]
  diagnosticQuestions DiagnosticQuestion[]
  diagnosticTopics    DiagnosticTopic[]

  @@map("exam_types")
}

// ====================================================================
// KONU ANLATIM (FREE TOPIC LEARNING DASHBOARD)
// ====================================================================

model ExamTopic {
  id            String   @id @default(cuid())
  examTypeId    String
  name          String
  slug          String
  description   String?
  questionCount Int?
  category      String?
  skillsTested  String?
  difficulty    String?
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examType       ExamType         @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  lessons        TopicLesson[]
  notes          TopicNote[]
  savedBy        SavedExamTopic[]
  studyGoalItems StudyGoalItem[]
  studyTimes     TopicStudyTime[]

  @@unique([examTypeId, slug])
  @@index([examTypeId])
  @@map("exam_topics")
}

model TopicNote {
  id          String   @id @default(cuid())
  userId      String
  examTopicId String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic ExamTopic @relation(fields: [examTopicId], references: [id], onDelete: Cascade)

  @@unique([userId, examTopicId])
  @@map("topic_notes")
}

model TopicLesson {
  id                 String   @id @default(cuid())
  topicId            String
  title              String
  position           Int      @default(0)
  videoUrl           String?
  durationMinutes    Int?
  contentBody        String?
  /** English translation of contentBody, generated on first request and cached (see lesson-translation.service). */
  contentBodyEn      String?
  diagnosticTopicIds String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  topic                ExamTopic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progresses           TopicLessonProgress[]
  curriculumActivities CurriculumActivity[]

  @@index([topicId])
  @@index([diagnosticTopicIds], type: Gin)
  @@map("topic_lessons")
}

model TopicLessonProgress {
  id            String    @id @default(cuid())
  userId        String
  topicLessonId String
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicLesson TopicLesson @relation(fields: [topicLessonId], references: [id], onDelete: Cascade)

  @@unique([userId, topicLessonId])
  @@map("topic_lesson_progresses")
}

/**
 * Active reading time a student spent on a Konu Anlatımı topic: only seconds with the tab visible
 * and the student active are counted, and the server caps each report by the time since the last
 * one, so leaving a tab open doesn't add hours. Shown as "Çalıştığım süre" in Beceri Analizi.
 */
model TopicStudyTime {
  id          String   @id @default(cuid())
  userId      String
  examTopicId String
  seconds     Int      @default(0)
  lastPingAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic ExamTopic @relation(fields: [examTopicId], references: [id], onDelete: Cascade)

  @@unique([userId, examTopicId])
  @@map("topic_study_times")
}

// ====================================================================
// IDENTITY & ACCESS
// ====================================================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String?
  name               String
  phone              String?
  nationalId         String?
  birthDate          DateTime?
  occupation         String?
  educationLevel     String?
  role               UserRole  @default(STUDENT)
  image              String?
  isActive           Boolean   @default(true)
  /// Set when the user proved they own the address (verification link, password reset or Google).
  emailVerifiedAt    DateTime?
  /// One-click opt-out from abandoned-cart reminders (the only non-essential transactional email).
  cartReminderOptOut Boolean   @default(false)
  /// When the user accepted the Üyelik Sözleşmesi (sign-up box, or first Google sign-in).
  termsAcceptedAt    DateTime?
  /// Ticari elektronik ileti permissions (Açık Rıza Metni A), each given separately; never pre-ticked.
  marketingEmail     Boolean   @default(false)
  marketingSms       Boolean   @default(false)
  marketingPhone     Boolean   @default(false)
  /// Show "Ayşe Y." on the weekly leaderboard instead of "Netfener öğrencisi" (opt-in).
  leaderboardOptIn   Boolean   @default(false)
  /// Personal invite code (netfener.com/register?ref=CODE), created the first time it is needed.
  referralCode       String?   @unique
  referredById       String?
  /// Set once the referrer has been rewarded for this user's first paid order.
  referralRewardedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  authTokens              AuthToken[]
  consentLogs             ConsentLog[]
  certificates            Certificate[]
  badges                  UserBadge[]
  pushSubscriptions       PushSubscription[]
  examInterests           UserExamInterest[]
  siteReviews             SiteReview[]              @relation("SiteReviewAuthor")
  ebookPromotionAccess    EbookPromotionAccess?
  ebookSelections         UserEbookSelection[]
  moderatedReviews        SiteReview[]              @relation("SiteReviewModerator")
  seoActivityLogs         SeoActivityLog[]
  seoAttribution          SeoAttribution?
  orders                  Order[]
  cart                    Cart?
  enrollments             Enrollment[]
  blogPosts               BlogPost[]
  topicLessonProgresses   TopicLessonProgress[]
  topicStudyTimes         TopicStudyTime[]
  topicNotes              TopicNote[]
  groupBookings           GroupLessonEnrollment[]
  instructedSessions      LiveSession[]             @relation("SessionInstructor")
  examGoals               ExamGoal[]
  diagnosticAttempts      DiagnosticAttempt[]
  onlineDenemeAttempts    OnlineDenemeAttempt[]
  studyRoadmapItems       StudyRoadmapItem[]
  analyticsEvents         AnalyticsEvent[]
  notifications           Notification[]
  reviews                 Review[]
  planSubscriptions       PlanSubscription[]
  savedExamTopics         SavedExamTopic[]
  visits                  UserVisit[]
  favorites               FavoriteProduct[]
  coachingProfile         CoachingProfile?
  studyPlanWeeks          StudyPlanWeek[]
  studyTasks              StudyTask[]
  planProposals           PlanProposal[]
  vocabCards              VocabCard[]
  mistakeEntries          MistakeEntry[]
  coachingCheckIns        CoachingCheckIn[]
  coachingFeedback        CoachingFeedback[]
  coachingReports         CoachingReport[]
  coachingNotifications   CoachingNotificationLog[]
  lexiconWords            LexiconWordState[]
  lexiconTests            LexiconSetTest[]
  writingFeedback         WritingFeedback[]
  mistakeExplanationViews MistakeExplanationView[]
  sentMessages            TeacherMessage[]          @relation("MessageStudent")
  answeredMessages        TeacherMessage[]          @relation("MessageResponder")
  studyGoals              StudyGoal[]
  englishPlacements       EnglishPlacement[]
  accessGrants            AccessGrant[]
  subscriptions           MembershipSubscription[]
  auditEvents             CommercialAudit[]
  cohortMemberships       CohortEnrollment[]
  cohortWaitlists         CohortWaitlist[]
  teachingCohorts         ProgrammeCohort[]         @relation("CohortTeacher")
  verifiedActivities      ActivityCompletion[]      @relation("ActivityVerifier")

  @@map("users")
}

/**
 * In-app notification center — there is no transactional email system (see .env.example), so this
 * is currently the only way a student learns that an order/payment status changed or a Writing
 * submission was graded, short of checking the relevant page themselves.
 */
/// What a notification is about. PURCHASE ones are kept; the rest are cleared after 30 days.
enum NotificationCategory {
  PURCHASE
  PAYMENT
  LESSON
  CART
  COACHING
  MESSAGE
  RESULT
  ACCOUNT
  ADMIN
  SYSTEM
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  category   NotificationCategory @default(SYSTEM)
  /// Notifications about the same thing share a key; a newer one replaces the older instead of
  /// stacking up (e.g. "order:<id>" goes from "havale bekleniyor" to "ödeme onaylandı").
  dedupeKey  String?
  title      String
  body       String?
  href       String?
  /// "Tamamlandı" in the notification centre.
  isRead     Boolean              @default(false)
  archivedAt DateTime?
  createdAt  DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

/**
 * A student's own rating/review of a product they bought — distinct from the admin-curated Testimonial model shown on marketing pages.
 */
model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

// ====================================================================
// CATALOG
// ====================================================================

model Product {
  id                 String          @id @default(cuid())
  slug               String          @unique
  title              String
  subtitle           String?
  category           ProductCategory
  examTypeId         String?
  level              ProductLevel?
  posterImageUrl     String?
  badgeLabel         String?
  basePrice          Decimal         @db.Decimal(12, 2)
  salePrice          Decimal         @db.Decimal(12, 2)
  currency           String          @default("TRY")
  isPublished        Boolean         @default(true)
  isFeatured         Boolean         @default(false)
  displayOrder       Int             @default(0)
  shortDescription   String?
  description        String?
  diagnosticTopicIds String[]        @default([])
  /**
   * Set only for category PLAN.
   */
  planTier           PlanTier?
  /**
   * Plan length in calendar months (PLAN only), so "1 aylık" is 30 or 31 days depending on the month.
   */
  accessMonths       Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  examType    ExamType?         @relation(fields: [examTypeId], references: [id])
  course      Course?
  book        Book?
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
  favoritedBy FavoriteProduct[]

  @@index([category])
  @@index([examTypeId])
  @@index([diagnosticTopicIds], type: Gin)
  @@map("products")
}

model Course {
  id                      String               @id @default(cuid())
  productId               String               @unique
  deliveryFormat          CourseDeliveryFormat @default(HYBRID)
  syllabusSummary         String?
  /**
   * Konuşma kulübü groups — the only courses the Uzman plan's SPEAKING_CLUB perk can be claimed on.
   */
  isSpeakingClub          Boolean              @default(false)
  curriculumKey           String?              @unique
  curriculumTargetMinutes Int?
  curriculumPublishedAt   DateTime?
  examFormatVerifiedAt    DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  cohorts      ProgrammeCohort[]
  modules      CourseModule[]
  liveSessions LiveSession[]
  enrollments  Enrollment[]
  perkClaims   PlanPerkClaim[]
  messages     TeacherMessage[]

  @@map("courses")
}

model CourseModule {
  description String?
  id          String   @id @default(cuid())
  courseId    String
  title       String
  position    Int
  createdAt   DateTime @default(now())

  course          Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons         RecordedLesson[]
  units           CurriculumUnit[]
  durationBudgets ModuleDurationBudget[]

  @@unique([courseId, position])
  @@map("course_modules")
}

model RecordedLesson {
  id              String  @id @default(cuid())
  moduleId        String
  unitId          String?
  title           String
  position        Int
  videoUrl        String?
  durationMinutes Int?
  isPreviewable   Boolean @default(false)
  description     String?

  module           CourseModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonProgresses LessonProgress[]
  unit             CurriculumUnit?      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  activities       CurriculumActivity[]

  @@unique([moduleId, position])
  @@index([unitId])
  @@map("recorded_lessons")
}

model LiveSession {
  id           String   @id @default(cuid())
  courseId     String
  title        String
  cohortLabel  String?
  startsAt     DateTime
  endsAt       DateTime
  timezone     String   @default("Europe/Istanbul")
  meetingUrl   String?
  recordingUrl String?
  capacity     Int?     @default(10)
  createdAt    DateTime @default(now())

  availabilityEnabled   Boolean                 @default(false)
  enrollmentOpen        Boolean                 @default(true)
  cancelled             Boolean                 @default(false)
  displayedOccupancy    Int?
  useDisplayedOccupancy Boolean                 @default(false)
  adminNotes            String?
  instructorId          String?
  recurringSeriesId     String?
  updatedAt             DateTime                @default(now()) @updatedAt
  instructor            User?                   @relation("SessionInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  recurringSeries       GroupLessonSeries?      @relation(fields: [recurringSeriesId], references: [id], onDelete: SetNull)
  bookings              GroupLessonEnrollment[]
  cohortId              String?
  cohort                ProgrammeCohort?        @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  activityCompletions   ActivityCompletion[]
  course                Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([cohortId], map: "live_sessions_cohort_id_idx")
  @@index([startsAt, availabilityEnabled])
  @@index([recurringSeriesId])
  @@index([courseId])
  @@map("live_sessions")
}

model Book {
  id             String     @id @default(cuid())
  productId      String     @unique
  author         String
  format         BookFormat @default(PDF)
  pageCount      Int?
  isbn           String?
  digitalFileUrl String?
  createdAt      DateTime   @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("books")
}

// ====================================================================
// ENROLLMENT & PROGRESS
// ====================================================================

model Enrollment {
  id                  String           @id @default(cuid())
  userId              String
  courseId            String
  orderItemId         String?          @unique
  status              EnrollmentStatus @default(ACTIVE)
  grantedAt           DateTime         @default(now())
  expiresAt           DateTime?
  /**
   * Monthly-billed group lessons (PREP_GROUP) only: the end of the paid billing month. When it
   * passes the student is notified; one day later live-lesson access locks until they renew.
   * Null = not billed monthly (legacy enrollments and every non-group course keep working as-is).
   */
  paidThrough         DateTime?
  /**
   * Set once the "payment due" notification for the current paidThrough has been sent.
   */
  renewalNoticeSentAt DateTime?

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  course              Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderItem           OrderItem?           @relation(fields: [orderItemId], references: [id])
  lessonProgresses    LessonProgress[]
  submissions         PracticeSubmission[]
  activityCompletions ActivityCompletion[]

  @@unique([userId, courseId])
  @@map("enrollments")
}

enum SubmissionStatus {
  PENDING
  REVIEWED
}

model PracticeSubmission {
  id              String           @id @default(cuid())
  enrollmentId    String
  title           String
  studentAnswer   String
  status          SubmissionStatus @default(PENDING)
  teacherFeedback String?
  score           Decimal?         @db.Decimal(5, 2)
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?

  enrollment         Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  activityCompletion ActivityCompletion?

  @@map("practice_submissions")
}

model LessonProgress {
  id               String    @id @default(cuid())
  enrollmentId     String
  recordedLessonId String
  completedAt      DateTime?

  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recordedLesson RecordedLesson @relation(fields: [recordedLessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, recordedLessonId])
  @@map("lesson_progress")
}

// ====================================================================
// COMMERCE
// ====================================================================

model Cart {
  id           String   @id @default(cuid())
  userId       String?  @unique
  sessionToken String?  @unique
  currency     String   @default("TRY")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  productId         String
  quantity          Int      @default(1)
  unitPriceSnapshot Decimal  @db.Decimal(12, 2)
  /**
   * The group-lesson slot a "Gruba Katıl" purchase should book once payment is confirmed.
   */
  groupSlotId       String?
  createdAt         DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id              String           @id @default(cuid())
  userId          String?
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  status          OrderStatus      @default(PENDING)
  subtotal        Decimal          @db.Decimal(12, 2)
  discountTotal   Decimal          @default(0) @db.Decimal(12, 2)
  /// One flat fee per order that holds a printed book; zero for digital-only orders.
  shippingTotal   Decimal          @default(0) @db.Decimal(12, 2)
  /// Where the printed books go. Absent on digital-only orders, and never guessed.
  shippingAddress Json?
  total           Decimal          @db.Decimal(12, 2)
  currency        String           @default("TRY")
  checkoutConsent Json?
  commercialKind  CommercialKind?
  checkoutKey     String?          @unique
  reservation     SeatReservation?
  couponCode      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user    User?       @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?
  invoice Invoice?

  @@map("orders")
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id              String           @id @default(cuid())
  code            String           @unique
  type            CouponType
  value           Decimal          @db.Decimal(12, 2)
  description     String?
  isActive        Boolean          @default(true)
  isPublic        Boolean          @default(false)
  minOrderAmount  Decimal?         @db.Decimal(12, 2)
  maxRedemptions  Int?
  redemptionCount Int              @default(0)
  expiresAt       DateTime?
  /// Personal coupons (referral rewards) can only be used by this user.
  ownerUserId     String?
  /// When set, the discount covers one unit of this category only (e.g. review rewards: one plan).
  appliesTo       ProductCategory?
  createdAt       DateTime         @default(now())

  @@index([ownerUserId])
  @@map("coupons")
}

model OrderItem {
  id              String           @id @default(cuid())
  orderId         String
  productId       String
  purchaseType    PurchaseType     @default(LEGACY)
  billingInterval BillingInterval?
  cohortId        String?
  cohort          ProgrammeCohort? @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  periodStartsAt  DateTime?
  paidThrough     DateTime?
  accessExpiresAt DateTime?
  titleSnapshot   String
  unitPrice       Decimal          @db.Decimal(12, 2)
  quantity        Int              @default(1)
  lineTotal       Decimal          @db.Decimal(12, 2)
  groupSlotId     String?

  order            Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product                 @relation(fields: [productId], references: [id])
  enrollment       Enrollment?
  planSubscription PlanSubscription?
  accessGrants     AccessGrant[]
  cohortEnrollment CohortEnrollment?
  subscription     MembershipSubscription?

  @@index([cohortId])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  provider    String        @default("MANUAL")
  providerRef String?
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("TRY")
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ====================================================================
// CONTENT & MARKETING
// ====================================================================

model Testimonial {
  id              String   @id @default(cuid())
  studentName     String
  studentPhotoUrl String?
  examTypeId      String?
  resultSummary   String?
  quote           String
  rating          Int      @default(5)
