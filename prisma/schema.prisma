generator client {
  provider      = "prisma-client"
  output        = "../lib/generated/prisma"
  moduleFormat  = "esm"
}

datasource db {
  provider = "postgresql"
}

// ====================================================================
// ENUMS
// ====================================================================

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum ExamCode {
  IELTS
  TOEFL
  PTE
  YDS
  YOKDIL_SOSYAL
  YOKDIL_SAGLIK
  YOKDIL_FEN
}

enum ProductCategory {
  PREP_GROUP
  MOCK_CAMP
  STUDY_PACKAGE
  TRANSLATION_SUPPORT
  BOOK
}

enum ProductLevel {
  BEGINNER_TO_ADVANCED
  INTERMEDIATE_ADVANCED
  JUNIOR
  SENIOR
}

enum CourseDeliveryFormat {
  HYBRID
  RECORDED_ONLY
  LIVE_ONLY
}

enum BookFormat {
  PDF
  PRINT
  PRINT_AND_PDF
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum CallbackRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

// ====================================================================
// DIAGNOSTIC / PERSONALIZED PREP JOURNEY ENUMS
// ====================================================================

enum ExamFamily {
  ACADEMIC_SKILLS
  TRANSLATION_GRAMMAR
}

enum GoalTimeframe {
  EXACT_DATE
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  UNKNOWN
}

enum DiagnosticTopicKind {
  SKILL
  SUBSKILL
  TOPIC
}

enum DiagnosticQuestionType {
  MCQ
  LISTENING_MCQ
  CLOZE
  TRANSLATION_EN_TR
  TRANSLATION_TR_EN
  SENTENCE_COMPLETION
  PARAGRAPH_COMPLETION
  READING_COMPREHENSION
  RESTATEMENT
  WRITING_TASK
  SPEAKING_TASK
}

enum DiagnosticDifficulty {
  KOLAY
  ORTA
  ZOR
}

enum DiagnosticAttemptKind {
  FULL_DIAGNOSTIC
  MASTERY_CHECK
  PRACTICE
  MOCK_EXAM
}

enum DiagnosticAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum DiagnosticSeverity {
  CRITICAL
  NEEDS_IMPROVEMENT
  DEVELOPING
  STRONG
}

enum RoadmapItemStatus {
  NOT_STARTED
  IN_PROGRESS
  MASTERY_CHECK_REQUIRED
  COMPLETED
}

// ====================================================================
// REFERENCE DATA
// ====================================================================

model ExamType {
  id               String   @id @default(cuid())
  code             ExamCode @unique
  slug             String   @unique
  name             String
  shortDescription String?
  iconKey          String?
  displayOrder     Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products           Product[]
  testimonials       Testimonial[]
  dictionaryTerms    DictionaryTerm[]
  scoreConversionRows ScoreConversionEntry[]
  calendarEntries    ExamCalendarEntry[]
  freeResources      FreeResource[]
  callbackRequests   CallbackRequest[]
  topics             ExamTopic[]
  examGoals          ExamGoal[]
  diagnosticAttempts DiagnosticAttempt[]
  diagnosticQuestions DiagnosticQuestion[]

  @@map("exam_types")
}

// ====================================================================
// KONU ANLATIM (FREE TOPIC LEARNING DASHBOARD)
// ====================================================================

model ExamTopic {
  id            String   @id @default(cuid())
  examTypeId    String
  name          String
  slug          String
  description   String?
  questionCount Int?
  category      String?
  skillsTested  String?
  difficulty    String?
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examType ExamType      @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  lessons  TopicLesson[]
  notes    TopicNote[]

  @@unique([examTypeId, slug])
  @@index([examTypeId])
  @@map("exam_topics")
}

model TopicNote {
  id          String   @id @default(cuid())
  userId      String
  examTopicId String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic ExamTopic @relation(fields: [examTopicId], references: [id], onDelete: Cascade)

  @@unique([userId, examTopicId])
  @@map("topic_notes")
}

model TopicLesson {
  id                 String   @id @default(cuid())
  topicId            String
  title              String
  position           Int      @default(0)
  videoUrl           String?
  durationMinutes    Int?
  contentBody        String?
  diagnosticTopicIds String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  topic      ExamTopic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progresses TopicLessonProgress[]

  @@index([topicId])
  @@index([diagnosticTopicIds], type: Gin)
  @@map("topic_lessons")
}

model TopicLessonProgress {
  id            String    @id @default(cuid())
  userId        String
  topicLessonId String
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicLesson TopicLesson @relation(fields: [topicLessonId], references: [id], onDelete: Cascade)

  @@unique([userId, topicLessonId])
  @@map("topic_lesson_progresses")
}

// ====================================================================
// IDENTITY & ACCESS
// ====================================================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String?
  name           String
  phone          String?
  nationalId     String?
  birthDate      DateTime?
  occupation     String?
  educationLevel String?
  role           UserRole  @default(STUDENT)
  image          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders               Order[]
  cart                 Cart?
  enrollments          Enrollment[]
  blogPosts            BlogPost[]
  topicLessonProgresses TopicLessonProgress[]
  topicNotes            TopicNote[]
  groupBookings GroupLessonEnrollment[]
  instructedSessions LiveSession[] @relation("SessionInstructor")
  examGoals            ExamGoal[]
  diagnosticAttempts   DiagnosticAttempt[]
  studyRoadmapItems    StudyRoadmapItem[]
  analyticsEvents      AnalyticsEvent[]

  @@map("users")
}

// ====================================================================
// CATALOG
// ====================================================================

model Product {
  id                 String          @id @default(cuid())
  slug               String          @unique
  title              String
  subtitle           String?
  category           ProductCategory
  examTypeId         String?
  level              ProductLevel?
  posterImageUrl     String?
  badgeLabel         String?
  basePrice          Decimal         @db.Decimal(12, 2)
  salePrice          Decimal         @db.Decimal(12, 2)
  currency           String          @default("TRY")
  isPublished        Boolean         @default(true)
  isFeatured         Boolean         @default(false)
  displayOrder       Int             @default(0)
  shortDescription   String?
  description        String?
  diagnosticTopicIds String[]        @default([])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  examType   ExamType? @relation(fields: [examTypeId], references: [id])
  course     Course?
  book       Book?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([category])
  @@index([examTypeId])
  @@index([diagnosticTopicIds], type: Gin)
  @@map("products")
}

model Course {
  id               String                @id @default(cuid())
  productId        String                @unique
  deliveryFormat   CourseDeliveryFormat  @default(HYBRID)
  syllabusSummary  String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  modules      CourseModule[]
  liveSessions LiveSession[]
  enrollments  Enrollment[]

  @@map("courses")
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  position  Int
  createdAt DateTime @default(now())

  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons RecordedLesson[]

  @@unique([courseId, position])
  @@map("course_modules")
}

model RecordedLesson {
  id              String   @id @default(cuid())
  moduleId        String
  title           String
  position        Int
  videoUrl        String?
  durationMinutes Int?
  isPreviewable   Boolean  @default(false)
  description     String?

  module           CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonProgresses LessonProgress[]

  @@unique([moduleId, position])
  @@map("recorded_lessons")
}

model LiveSession {
  id            String   @id @default(cuid())
  courseId      String
  title         String
  cohortLabel   String?
  startsAt      DateTime
  endsAt        DateTime
  timezone      String   @default("Europe/Istanbul")
  meetingUrl    String?
  recordingUrl  String?
  capacity      Int? @default(10)
  createdAt     DateTime @default(now())

  availabilityEnabled Boolean @default(false)
  enrollmentOpen Boolean @default(true)
  cancelled Boolean @default(false)
  displayedOccupancy Int?
  useDisplayedOccupancy Boolean @default(false)
  adminNotes String?
  instructorId String?
  recurringSeriesId String?
  updatedAt DateTime @default(now()) @updatedAt
  instructor User? @relation("SessionInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  recurringSeries GroupLessonSeries? @relation(fields: [recurringSeriesId], references: [id], onDelete: SetNull)
  bookings GroupLessonEnrollment[]
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([startsAt, availabilityEnabled])
  @@index([recurringSeriesId])
  @@index([courseId])
  @@map("live_sessions")
}

model Book {
  id             String     @id @default(cuid())
  productId      String     @unique
  author         String
  format         BookFormat @default(PDF)
  pageCount      Int?
  isbn           String?
  digitalFileUrl String?
  createdAt      DateTime   @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("books")
}

// ====================================================================
// ENROLLMENT & PROGRESS
// ====================================================================

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  orderItemId String?          @unique
  status      EnrollmentStatus @default(ACTIVE)
  grantedAt   DateTime         @default(now())
  expiresAt   DateTime?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderItem        OrderItem?        @relation(fields: [orderItemId], references: [id])
  lessonProgresses LessonProgress[]
  submissions      PracticeSubmission[]

  @@unique([userId, courseId])
  @@map("enrollments")
}

enum SubmissionStatus {
  PENDING
  REVIEWED
}

model PracticeSubmission {
  id              String           @id @default(cuid())
  enrollmentId    String
  title           String
  studentAnswer   String
  status          SubmissionStatus @default(PENDING)
  teacherFeedback String?
  score           Decimal?         @db.Decimal(5, 2)
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("practice_submissions")
}

model LessonProgress {
  id               String    @id @default(cuid())
  enrollmentId     String
  recordedLessonId String
  completedAt      DateTime?

  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recordedLesson RecordedLesson @relation(fields: [recordedLessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, recordedLessonId])
  @@map("lesson_progress")
}

// ====================================================================
// COMMERCE
// ====================================================================

model Cart {
  id           String   @id @default(cuid())
  userId       String?  @unique
  sessionToken String?  @unique
  currency     String   @default("TRY")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  productId         String
  quantity          Int      @default(1)
  unitPriceSnapshot Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id             String      @id @default(cuid())
  userId         String?
  guestName      String?
  guestEmail     String?
  guestPhone     String?
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(12, 2)
  discountTotal  Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  currency       String      @default("TRY")
  couponCode     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user    User?       @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@map("orders")
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  value           Decimal    @db.Decimal(12, 2)
  description     String?
  isActive        Boolean    @default(true)
  isPublic        Boolean    @default(false)
  minOrderAmount  Decimal?   @db.Decimal(12, 2)
  maxRedemptions  Int?
  redemptionCount Int        @default(0)
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())

  @@map("coupons")
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String
  titleSnapshot String
  unitPrice     Decimal  @db.Decimal(12, 2)
  quantity      Int      @default(1)
  lineTotal     Decimal  @db.Decimal(12, 2)

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id])
  enrollment Enrollment?

  @@map("order_items")
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String        @unique
  provider   String        @default("MANUAL")
  providerRef String?
  amount     Decimal       @db.Decimal(12, 2)
  currency   String        @default("TRY")
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ====================================================================
// CONTENT & MARKETING
// ====================================================================

model Testimonial {
  id             String   @id @default(cuid())
  studentName    String
  studentPhotoUrl String?
  examTypeId     String?
  resultSummary  String?
  quote          String
  rating         Int      @default(5)
  isPublished    Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())

  examType ExamType? @relation(fields: [examTypeId], references: [id])

  @@map("testimonials")
}

model BlogCategory {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  displayOrder Int      @default(0)
  active       Boolean  @default(true)

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  excerpt        String
  content        String
  coverImageUrl  String?
  authorId       String
  categoryId     String?
  tags           String[]       @default([])
  status         BlogPostStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  author   User          @relation(fields: [authorId], references: [id])
  category BlogCategory? @relation(fields: [categoryId], references: [id])

  @@map("blog_posts")
}

// ====================================================================
// FREE TOOLS & RESOURCES
// ====================================================================

model DictionaryTerm {
  id              String  @id @default(cuid())
  term            String
  definition      String
  exampleSentence String?
  examTypeId      String?

  examType ExamType? @relation(fields: [examTypeId], references: [id])

  @@index([term])
  @@map("dictionary_terms")
}

model ScoreConversionEntry {
  id           String @id @default(cuid())
  examTypeId   String
  inputLabel   String
  resultLabel  String
  notes        String?
  minCorrect   Int
  maxCorrect   Int
  displayOrder Int    @default(0)

  examType ExamType @relation(fields: [examTypeId], references: [id], onDelete: Cascade)

  @@map("score_conversion_entries")
}

model ExamCalendarEntry {
  id                  String    @id @default(cuid())
  examTypeId          String
  title               String?
  examDate            DateTime
  applicationDeadline DateTime?
  resultDate          DateTime?
  year                Int

  examType ExamType @relation(fields: [examTypeId], references: [id], onDelete: Cascade)

  @@map("exam_calendar_entries")
}

model FreeResource {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String?
  fileUrl       String
  examTypeId    String?
  category      String?
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())

  examType ExamType? @relation(fields: [examTypeId], references: [id])

  @@map("free_resources")
}

// ====================================================================
// LEAD GENERATION
// ====================================================================

model CallbackRequest {
  id          String                @id @default(cuid())
  name        String
  phone       String
  note        String?
  examTypeId  String?
  status      CallbackRequestStatus @default(NEW)
  contactedAt DateTime?
  createdAt   DateTime              @default(now())

  examType ExamType? @relation(fields: [examTypeId], references: [id])

  @@map("callback_requests")
}

model GroupLessonSeries {
 id String @id @default(cuid())
 repeatUntil DateTime
 createdAt DateTime @default(now())
 sessions LiveSession[]
 @@map("group_lesson_series")
}
enum GroupBookingStatus {
 ACTIVE
 CANCELLED
}
model GroupLessonEnrollment {
 id String @id @default(cuid())
 slotId String
 studentId String
 status GroupBookingStatus @default(ACTIVE)
 enrolledAt DateTime @default(now())
 cancelledAt DateTime?
 slot LiveSession @relation(fields: [slotId], references: [id], onDelete: Restrict)
 student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
 @@unique([slotId, studentId])
 @@index([slotId, status])
 @@map("group_lesson_enrollments")
}

// ====================================================================
// PERSONALIZED PREP JOURNEY (GOAL → DIAGNOSTIC → ROADMAP)
// ====================================================================

model ExamGoal {
  id                 String        @id @default(cuid())
  userId             String
  examTypeId         String
  currentScoreRaw    String?
  currentScoreKnown  Boolean       @default(false)
  targetScoreRaw     String
  targetTimeframe    GoalTimeframe @default(UNKNOWN)
  targetDate         DateTime?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  examType        ExamType            @relation(fields: [examTypeId], references: [id])
  attempts        DiagnosticAttempt[]
  roadmapItems    StudyRoadmapItem[]

  @@index([userId, examTypeId, isActive])
  @@map("exam_goals")
}

model DiagnosticTopic {
  id             String                @id @default(cuid())
  slug           String                @unique
  name           String
  kind           DiagnosticTopicKind
  examFamilies   ExamFamily[]
  parentTopicId  String?
  importanceWeight Int                 @default(1)
  estimatedMinutes Int?
  description    String?
  displayOrder   Int                   @default(0)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  parent   DiagnosticTopic?  @relation("TopicHierarchy", fields: [parentTopicId], references: [id], onDelete: SetNull)
  children DiagnosticTopic[] @relation("TopicHierarchy")

  primaryQuestions   DiagnosticQuestion[]     @relation("PrimaryTopic")
  topicResults       DiagnosticTopicResult[]
  roadmapItems       StudyRoadmapItem[]
  dependsOn          TopicDependency[]        @relation("TopicDependents")
  dependents         TopicDependency[]        @relation("TopicPrerequisites")

  @@index([kind])
  @@index([parentTopicId])
  @@map("diagnostic_topics")
}

model TopicDependency {
  id               String @id @default(cuid())
  topicId          String
  dependsOnTopicId String

  topic          DiagnosticTopic @relation("TopicDependents", fields: [topicId], references: [id], onDelete: Cascade)
  dependsOnTopic DiagnosticTopic @relation("TopicPrerequisites", fields: [dependsOnTopicId], references: [id], onDelete: Cascade)

  @@unique([topicId, dependsOnTopicId])
  @@map("topic_dependencies")
}

model DiagnosticQuestion {
  id                String                 @id @default(cuid())
  examFamily        ExamFamily
  examTypeId        String?
  topicId           String
  secondaryTopicIds String[]               @default([])
  questionType      DiagnosticQuestionType
  difficulty        DiagnosticDifficulty   @default(ORTA)
  prompt            String
  passageText       String?
  audioUrl          String?
  options           Json?
  correctAnswer     String?
  explanation       String?
  tags              String[]               @default([])
  isActive          Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  examType  ExamType?        @relation(fields: [examTypeId], references: [id])
  topic     DiagnosticTopic  @relation("PrimaryTopic", fields: [topicId], references: [id], onDelete: Restrict)
  responses DiagnosticResponse[]

  @@index([examFamily, topicId, isActive])
  @@index([examTypeId])
  @@map("diagnostic_questions")
}

model DiagnosticAttempt {
  id            String                  @id @default(cuid())
  userId        String
  examTypeId    String
  examFamily    ExamFamily
  kind          DiagnosticAttemptKind   @default(FULL_DIAGNOSTIC)
  scopeTopicId  String?
  goalId        String?
  status        DiagnosticAttemptStatus @default(IN_PROGRESS)
  questionOrder String[]
  currentIndex  Int                     @default(0)
  startedAt     DateTime                @default(now())
  completedAt   DateTime?
  createdAt     DateTime                @default(now())

  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  examType  ExamType                @relation(fields: [examTypeId], references: [id])
  goal      ExamGoal?               @relation(fields: [goalId], references: [id], onDelete: SetNull)
  responses DiagnosticResponse[]
  topicResults DiagnosticTopicResult[]

  @@index([userId, examTypeId, status])
  @@index([goalId])
  @@map("diagnostic_attempts")
}

model DiagnosticResponse {
  id             String    @id @default(cuid())
  attemptId      String
  questionId     String
  answerRaw      String?
  isCorrect      Boolean?
  gradingStatus  SubmissionStatus?
  teacherFeedback String?
  score          Decimal?  @db.Decimal(5, 2)
  reviewedAt     DateTime?
  answeredAt     DateTime  @default(now())

  attempt  DiagnosticAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question DiagnosticQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@map("diagnostic_responses")
}

model DiagnosticTopicResult {
  id               String             @id @default(cuid())
  attemptId        String
  userId           String
  topicId          String
  questionsAnswered Int
  questionsCorrect  Int
  accuracy          Float
  severity          DiagnosticSeverity
  createdAt         DateTime           @default(now())

  attempt DiagnosticAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  topic   DiagnosticTopic   @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@unique([attemptId, topicId])
  @@index([userId, topicId, createdAt])
  @@map("diagnostic_topic_results")
}

model StudyRoadmapItem {
  id                 String             @id @default(cuid())
  userId             String
  goalId             String
  topicId            String
  priorityRank       Int
  severityAtCreation DiagnosticSeverity
  status             RoadmapItemStatus  @default(NOT_STARTED)
  sourceAttemptId    String?
  createdAt          DateTime           @default(now())
  startedAt          DateTime?
  completedAt        DateTime?

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal  ExamGoal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  topic DiagnosticTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@unique([userId, goalId, topicId])
  @@index([userId, goalId, priorityRank])
  @@map("study_roadmap_items")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}
